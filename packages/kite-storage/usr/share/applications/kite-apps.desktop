[Desktop Entry]
Type=Application
Name=App Centre
Comment=Install and remove apps, keep apps or folders on an external disk, update KiteOS and the system
Exec=kite-app-centre
Icon=system-software-install
Categories=System;Settings;PackageManager;
Keywords=install;software;store;apps;storage;external;usb;disk;update;
Terminal=false
StartupNotify=true
StartupWMClass=kite-apps
