#!/bin/bash
# kite-apps — "Apps & Storage": install apps (optionally onto the external
# disk), move apps/data/folders between internal and external storage, and
# update the system. A small yad front-end for /usr/sbin/kite-storage.
set -uo pipefail

TITLE="Apps & Storage"
ICON=system-software-install
KS=/usr/sbin/kite-storage
ME=$(id -un)

y() { yad --title="$TITLE" --window-icon="$ICON" --center "$@"; }

info()  { y --image=dialog-information --text="$1" --button=OK:0 --width=420 >/dev/null 2>&1; }
error() { y --image=dialog-error --text="$1" --button=OK:0 --width=420 >/dev/null 2>&1; }

askpass() {
    # Used by sudo -A when no polkit agent is running.
    yad --title="$TITLE" --center --entry --hide-text --image=dialog-password \
        --text="Enter your password to make changes:" --button=OK:0 --button=Cancel:1 2>/dev/null
}
if [ "${1:-}" = --askpass ]; then askpass; exit $?; fi

# Run kite-storage as root and show its output live. Returns its exit status.
run_root() {
    local log rc
    log=$(mktemp)
    (
        pkexec "$KS" "$@"
        rc=$?
        if [ "$rc" = 126 ] || [ "$rc" = 127 ]; then
            # No polkit agent / dismissed: fall back to sudo with a password box.
            SUDO_ASKPASS="$0" sudo -A -E "$KS" "$@"
            rc=$?
        fi
        echo "$rc" > "$log.rc"
    ) 2>&1 | tee "$log" | y --text-info --tail --width=720 --height=420 \
                              --text="Working… (you can close this window when it says done)" \
                              --button=Close:0 >/dev/null 2>&1
    rc=$(cat "$log.rc" 2>/dev/null || echo 1)
    rm -f "$log" "$log.rc"
    return "$rc"
}

ext_ready() {
    local EXT_UUID="" EXT_MOUNT=/mnt/kite-external
    # shellcheck disable=SC1091
    [ -r /etc/kite/storage.conf ] && . /etc/kite/storage.conf
    [ -n "$EXT_UUID" ] && [ -f "$EXT_MOUNT/kite/.kite-storage" ]
}

choose_location() {
    # Prints "--app-ext" and/or "--data-ext" for the choices made.
    local res
    res=$(y --form --width=460 --text="<b>Where should this app live?</b>\nIt is installed on the internal disk first, then copied to the external disk and linked back." \
          --field="Put the app's program files on the external disk:CHK" "$1" \
          --field="Put its settings and data on the external disk:CHK" "$2" \
          --button=Cancel:1 --button=Continue:0) || return 1
    IFS='|' read -r a d _ <<< "$res"
    [ "$a" = TRUE ] && echo --app-ext
    [ "$d" = TRUE ] && echo --data-ext
    return 0
}

do_install() {
    local term list pkg opts=()
    term=$(y --entry --width=420 --text="Search for an app to install (e.g. gimp, vlc, inkscape):" \
           --button=Cancel:1 --button=Search:0) || return
    [ -n "$term" ] || return
    list=$(apt-cache search -- "$term" 2>/dev/null | head -n 300 |
           awk -F' - ' '{ print $1; sub(/^[^-]*- /, ""); print $0 }')
    [ -n "$list" ] || { info "Nothing found for “$term”."; return; }
    pkg=$(printf '%s\n' "$list" | y --list --width=760 --height=480 --text="Pick the app to install:" \
          --column=Package --column=Description --print-column=1 --separator= \
          --button=Cancel:1 --button=Next:0) || return
    [ -n "$pkg" ] || return
    if ext_ready; then
        mapfile -t opts < <(choose_location TRUE TRUE) || return
    else
        y --image=dialog-question --width=420 --text="No external disk is set up, so $pkg will be installed on the internal disk.\nYou can move it later." \
          --button=Cancel:1 --button=Install:0 >/dev/null 2>&1 || return
    fi
    if run_root install "${opts[@]}" --user "$ME" "$pkg"; then
        info "$pkg is installed."
    else
        error "Installing $pkg failed. See the log for details."
    fi
}

pick_installed_app() {
    # Apps = installed packages that ship a launcher in /usr/share/applications.
    local f pkg
    for f in /usr/share/applications/*.desktop; do
        grep -q '^NoDisplay=true' "$f" && continue
        pkg=$(dpkg-query -S "$f" 2>/dev/null | head -n1 | cut -d: -f1)
        [ -n "$pkg" ] && printf '%s\n%s\n' "$pkg" "$(sed -n 's/^Name=//p' "$f" | head -n1)"
    done | paste - - | sort -u | tr '\t' '\n' |
        y --list --width=560 --height=460 --text="$1" --column=Package --column=App \
          --print-column=1 --separator= --button=Cancel:1 --button=Next:0
}

do_move_app() {
    ext_ready || { error "Set up and connect an external disk first."; return; }
    local pkg opts=() o
    pkg=$(pick_installed_app "Which app should move to the external disk?") || return
    [ -n "$pkg" ] || return
    mapfile -t opts < <(choose_location TRUE TRUE) || return
    for o in "${opts[@]}"; do
        case "$o" in
            --app-ext)  run_root move-app "$pkg" || { error "Moving $pkg failed."; return; } ;;
            --data-ext) run_root move-data "$pkg" --user "$ME" || { error "Moving the data of $pkg failed."; return; } ;;
        esac
    done
    info "Done. Close and reopen $pkg if it was running."
}

do_restore_app() {
    local pkg
    pkg=$("$KS" status | awk '$1 == "app" || $1 == "data" { print $2 }' | sort -u | grep -v '^folder$' |
          y --list --width=420 --height=360 --text="Which app should come back to the internal disk?" \
            --column=Package --print-column=1 --separator= --button=Cancel:1 --button=Next:0) || return
    [ -n "$pkg" ] || return
    run_root restore-app "$pkg" && run_root restore-data "$pkg" --user "$ME" &&
        info "$pkg is back on the internal disk." || error "Restoring $pkg failed."
}

do_move_dir() {
    ext_ready || { error "Set up and connect an external disk first."; return; }
    local dir
    dir=$(y --file --directory --filename="$HOME/" --width=720 --height=460 \
          --text="Choose a folder to keep on the external disk (for example Videos or Downloads):") || return
    [ -n "$dir" ] || return
    run_root move-dir "$dir" --user "$ME" && info "“$dir” now lives on the external disk." || error "Moving the folder failed."
}

do_setup() {
    local list dev fmt
    list=$(lsblk -rpno NAME,SIZE,FSTYPE,LABEL,TRAN,HOTPLUG,TYPE |
           awk '$7 == "part" || $7 == "disk" { print }' |
           while read -r name size fstype label _ _ type; do
               parent=$(lsblk -no PKNAME "$name" 2>/dev/null)
               rm=$(cat "/sys/block/$(basename "${parent:-$name}")/removable" 2>/dev/null || echo 0)
               t=$(lsblk -dno TRAN "/dev/${parent:-$(basename "$name")}" 2>/dev/null)
               [ "$type" = part ] || continue
               [ "$rm" = 1 ] || [ "$t" = usb ] || [[ "$name" == /dev/mmcblk[1-9]* ]] || continue
               printf '%s\n%s\n%s\n%s\n' "$name" "$size" "${fstype:-none}" "${label:--}"
           done)
    [ -n "$list" ] || { error "No external USB or SD-card partition found. Plug the disk in and try again."; return; }
    dev=$(printf '%s\n' "$list" | y --list --width=560 --height=320 --text="Choose the external disk partition:" \
          --column=Partition --column=Size --column="File system" --column=Label --print-column=1 --separator= \
          --button=Cancel:1 --button=Next:0) || return
    [ -n "$dev" ] || return
    fmt=()
    case "$(lsblk -no FSTYPE "$dev")" in
        ext4|ext3|btrfs|xfs|f2fs)
            y --image=dialog-question --width=440 --text="$dev already has a Linux file system. Use it as it is (keeps your files)?" \
              --button="Erase and format:2" --button=Cancel:1 --button="Use as is:0" >/dev/null 2>&1
            case $? in 0) ;; 2) fmt=(--format) ;; *) return ;; esac ;;
        *)
            y --image=dialog-warning --width=440 --text="<b>$dev must be formatted as ext4 to hold apps.</b>\n\nEVERYTHING on it will be erased. Continue?" \
              --button=Cancel:1 --button="Erase and format:0" >/dev/null 2>&1 || return
            fmt=(--format) ;;
    esac
    run_root setup "$dev" "${fmt[@]}" && info "The external disk is ready." || error "Setting up the disk failed."
}

do_status() {
    "$KS" status 2>&1 | y --text-info --width=720 --height=420 --fontname="Monospace 9" --button=Close:0 >/dev/null 2>&1
}

do_update() {
    run_root update && info "Everything is up to date." || error "The update failed. See the log for details."
}

while true; do
    choice=$(y --list --width=480 --height=380 --no-headers --text="<b>What would you like to do?</b>" \
             --column=Icon:IMG --column=Action --column=id:HD --print-column=3 --separator= \
             system-software-install "Install an app" install \
             go-next "Move an app to the external disk" move \
             go-previous "Bring an app back to the internal disk" restore \
             folder "Keep a folder on the external disk" folder \
             drive-removable-media "Set up an external disk" setup \
             drive-harddisk "Storage overview" status \
             system-software-update "Update apps and system" update \
             --button=Close:1 --button=Open:0) || exit 0
    case "$choice" in
        install) do_install ;;
        move) do_move_app ;;
        restore) do_restore_app ;;
        folder) do_move_dir ;;
        setup) do_setup ;;
        status) do_status ;;
        update) do_update ;;
        *) exit 0 ;;
    esac
done
