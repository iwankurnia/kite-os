# Sourced by /etc/X11/Xsession. Start the KiteOS compositor (picom: window
# animations and shadows) before XFCE starts, so xfwm4's own compositor is
# already switched off when xfwm4 comes up. Runs in the background and
# never blocks login; /etc/xdg/autostart/kite-compositor.desktop is the
# fallback when the session doesn't go through Xsession.
if [ -x /usr/lib/kite/desktop/start-compositor ]; then
    /usr/lib/kite/desktop/start-compositor >>"$HOME/.xsession-errors" 2>&1 &
fi
