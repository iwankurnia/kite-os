# Sourced by /etc/X11/Xsession. Per-user KiteOS defaults (never blocks login).
if [ -x /usr/lib/kite/desktop/kite-user-init ]; then
    /usr/lib/kite/desktop/kite-user-init >>"$HOME/.xsession-errors" 2>&1 || true
fi
# Skip the "which panel layout?" question; KiteOS ships its own.
XFCE_PANEL_MIGRATE_DEFAULT=1
export XFCE_PANEL_MIGRATE_DEFAULT
# Launcher entries KiteOS hides (duplicates) live in /usr/share/kite/xdg;
# it must come after /usr/local/share (apps moved to an external disk) and
# before /usr/share.
XDG_DATA_DIRS="/usr/local/share:/usr/share/kite/xdg:${XDG_DATA_DIRS:-/usr/share}"
export XDG_DATA_DIRS
# Autostart entries KiteOS switches off (Debian's plain picom: KiteOS starts
# its own) live in /usr/share/kite/xdg-config, found before /etc/xdg.
XDG_CONFIG_DIRS="/usr/share/kite/xdg-config:${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_CONFIG_DIRS
