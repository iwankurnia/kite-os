#!/bin/sh
set -e
# Give Brave its own launcher back (see preinst).
case "$1" in
    remove|abort-install|disappear) undivert=1 ;;
    # Back to a version without the wrapper: it must not lose the launcher.
    abort-upgrade) dpkg --compare-versions "$2" lt 1.1.0 && undivert=1 ;;
esac
if [ -n "${undivert:-}" ]; then
    dpkg-divert --package kite-desktop --remove --rename \
        --divert /usr/bin/brave-browser-stable.distrib /usr/bin/brave-browser-stable >/dev/null
fi
# Login screen files kite-login-theme wrote (they point at backgrounds that go
# with the package): its lightdm-gtk-greeter file, your own picture, and the
# slick-greeter file of kite-desktop before 1.3.0 if it is ours.
if [ "$1" = purge ]; then
    for greeter_conf in /etc/lightdm/lightdm-gtk-greeter.conf.d/90-kite-login-background.conf \
                        /etc/lightdm/slick-greeter.conf; do
        if [ -f "$greeter_conf" ] &&
                head -n1 "$greeter_conf" | grep -q '^# Written by kite-login-theme'; then
            rm -f "$greeter_conf"
        fi
    done
    rm -f /var/lib/kite/login-background.jpg /var/lib/kite/login-background.png /var/lib/kite/login-accent.css
    rmdir /var/lib/kite 2>/dev/null || true
fi
exit 0
