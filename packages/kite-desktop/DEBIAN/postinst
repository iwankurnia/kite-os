#!/bin/sh
set -e
if [ "$1" = configure ]; then
    command -v glib-compile-schemas >/dev/null && glib-compile-schemas /usr/share/glib-2.0/schemas || true
    # Every icon theme gets its cache (Papirus and Adwaita had none: the ISO
    # build sets them up before the cache tool is there, and nothing builds
    # it later). Without one, every GTK app scans Papirus's 43,000 files when
    # it starts (0.4 s for KiteOS Start on the N4020).
    if command -v gtk-update-icon-cache >/dev/null; then
        for t in /usr/share/icons/*/; do
            [ -f "$t/index.theme" ] && gtk-update-icon-cache -q -f "$t" || true
        done
    fi
    # Icon themes dropped in 1.3.0: the ISO build left an icon cache in each,
    # which dpkg does not own, so their folders would stay behind.
    for t in KiteOS KiteOS-Tray-Windows KiteOS-Tray-Mac; do
        if [ -d "/usr/share/icons/$t" ] && [ ! -e "/usr/share/icons/$t/index.theme" ]; then
            rm -f "/usr/share/icons/$t/icon-theme.cache"
            find "/usr/share/icons/$t" -depth -type d -empty -delete 2>/dev/null || true
        fi
    done
    if [ -x /usr/bin/xfce4-terminal.wrapper ]; then
        update-alternatives --set x-terminal-emulator /usr/bin/xfce4-terminal.wrapper >/dev/null 2>&1 || true
    fi
    # /usr/bin/brave-browser-stable is our wrapper and always exists; look
    # for Brave itself (its launcher, diverted by preinst, or the binary).
    if [ -x /usr/bin/brave-browser-stable.distrib ] || [ -x /opt/brave.com/brave/brave ]; then
        update-alternatives --set x-www-browser /usr/bin/brave-browser-stable >/dev/null 2>&1 || true
    fi
    systemctl set-default graphical.target >/dev/null 2>&1 || true
    # Memory protection for the X server and the desktop (lightdm.service.d,
    # system.slice.d, user.slice.d, user-.slice.d): in force from now on.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    # The installer (Calamares) wrote the greeter it found into lightdm.conf,
    # which LightDM reads after lightdm.conf.d: until kite-desktop 1.3.0 that
    # was slick-greeter. Point that line at the KiteOS login screen, or the
    # login screen stays blank once slick-greeter is removed.
    if [ -f /etc/lightdm/lightdm.conf ] &&
            grep -q '^greeter-session=slick-greeter$' /etc/lightdm/lightdm.conf; then
        sed -i 's/^greeter-session=slick-greeter$/greeter-session=lightdm-gtk-greeter/' /etc/lightdm/lightdm.conf
    fi
fi
exit 0
