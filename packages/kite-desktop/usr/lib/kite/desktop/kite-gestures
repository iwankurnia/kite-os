#!/usr/bin/python3 -I
"""KiteOS three-finger touchpad gestures (kite-gestures.service, as root).

  swipe up      the overview (every window)
  swipe down    back from the overview
  swipe sideways  the Alt+Tab switcher: it opens as the fingers move, each
                  STEP of travel moves the choice (right: next, left: back),
                  lifting the fingers goes to the chosen window

Reads the touchpad through "libinput debug-events" (libinput-tools), which
needs root: putting the user in the "input" group instead would let any of
their apps read the keyboard. A finished swipe is handed to the window
switcher (kite-switcher) of the person at the screen, over their session's
D-Bus, as that user. X itself ignores three-finger swipes, so nothing else
reacts to them.
"""
import os
import re
import subprocess
import sys
import time

FINGERS = 3
MIN_TRAVEL = 60          # libinput units (about px) before a swipe counts
STEP = 50                # more sideways travel per further window (the first: MIN_TRAVEL)
FLICK = 0.25             # s: a sideways swipe this short moves one window, however far
FLICK_V = 30             # an up or down flick counts from this much travel
# "GESTURE_SWIPE_UPDATE   7  +0.242s  3  -0.11/-7.24 (...)": libinput puts a
# running count of repeated events before the time (missing it lost every
# swipe on the device)
LINE = re.compile(r"GESTURE_SWIPE_(BEGIN|UPDATE|END)\s+(?:\d+\s+)?\+([\d.]+)s\s+(\d+)(?:\s+(-?[\d.]+)/\s*(-?[\d.]+))?(.*)")


def direction(dx, dy):
    """'up', 'down', 'left', 'right' for a swipe of DX, DY, or None if short."""
    if max(abs(dx), abs(dy)) < MIN_TRAVEL:
        return None
    if abs(dy) >= abs(dx):
        return "up" if dy < 0 else "down"
    return "left" if dx < 0 else "right"


def parse(lines):
    """What three-finger swipes ask for, from libinput debug-events output:
    'up' / 'down' when an up or down swipe ends; for a sideways one
    'h-begin' as soon as it is clearly sideways, then 'h-next' / 'h-prev'
    for each STEP of travel, and 'h-end' (or 'h-cancel') when it ends.
    Swipes with another number of fingers are ignored."""
    dx = dy = 0.0
    active = False
    mode = None              # None until it is clearly 'h' or 'v'
    steps = 0
    for line in lines:
        m = LINE.search(line)
        if not m:
            continue
        kind, at, fingers = m.group(1), float(m.group(2)), int(m.group(3))
        if fingers != FINGERS:
            active = False
            continue
        if kind == "BEGIN":
            dx = dy = 0.0
            active, mode, steps = True, None, 0
        elif kind == "UPDATE" and active and m.group(4) is not None:
            dx += float(m.group(4))
            dy += float(m.group(5))
            if mode is None and max(abs(dx), abs(dy)) >= MIN_TRAVEL:
                mode = "h" if abs(dx) > abs(dy) else "v"
                if mode == "h":
                    h_at = at
                    yield "h-begin"
                else:
                    # up or down: at once, quick or slow (not when it ends)
                    yield "up" if dy < 0 else "down"
            if mode == "h":
                # one window as soon as it is sideways (a short swipe: just
                # that one), then one more per further STEP
                n = 1 + int(max(0.0, abs(dx) - MIN_TRAVEL) / STEP)
                if at - h_at < FLICK:
                    n = 1               # a quick flick: one window, however far
                want = n if dx > 0 else -n
                while steps < want:
                    steps += 1
                    yield "h-next"
                while steps > want:
                    steps -= 1
                    yield "h-prev"
        elif kind == "END" and active:
            active = False
            cancelled = "cancelled" in (m.group(6) or "")
            if mode == "h":
                yield "h-cancel" if cancelled else "h-end"
            elif mode is None and not cancelled and abs(dy) >= FLICK_V and abs(dy) > abs(dx):
                yield "up" if dy < 0 else "down"     # a quick flick, short of MIN_TRAVEL


def session_user():
    """(uid, gid) of the person at the screen (seat0's active session), or None."""
    try:
        out = subprocess.run(["loginctl", "list-sessions", "--no-legend"], capture_output=True,
                             text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        sid = line.split()[0] if line.split() else None
        if not sid:
            continue
        try:
            props = dict(l.split("=", 1) for l in subprocess.run(
                ["loginctl", "show-session", sid, "-p", "Active", "-p", "Seat", "-p", "User", "-p", "Type"],
                capture_output=True, text=True, timeout=5).stdout.splitlines() if "=" in l)
        except (OSError, subprocess.SubprocessError):
            continue
        if props.get("Active") == "yes" and props.get("Seat") == "seat0" and props.get("Type") in ("x11", "wayland"):
            uid = int(props["User"])
            import pwd
            return uid, pwd.getpwuid(uid).pw_gid
    return None


def send(swipe):
    who = session_user()
    if who is None:
        return
    uid, gid = who
    bus = "unix:path=/run/user/%d/bus" % uid
    subprocess.run(["setpriv", "--reuid=%d" % uid, "--regid=%d" % gid, "--init-groups",
                    "env", "DBUS_SESSION_BUS_ADDRESS=" + bus,
                    "gdbus", "call", "--session", "--timeout", "2", "--dest", "org.kiteos.Switcher",
                    "--object-path", "/org/kiteos/Switcher", "--method", "org.gtk.Actions.Activate",
                    "swipe", "[<'%s'>]" % swipe, "@a{sv} {}"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=10)


def main():
    import queue
    import threading
    todo = queue.Queue()

    def sender():                # in order, without holding up the reading
        while True:
            send(todo.get())
    threading.Thread(target=sender, daemon=True).start()
    while True:
        try:
            # line-buffered: into a pipe libinput holds its output back
            # (about 4 KB), so swipes arrived late or never
            proc = subprocess.Popen(["stdbuf", "-oL", "libinput", "debug-events"], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True, bufsize=1)
        except OSError as e:
            print("kite-gestures: %s" % e, file=sys.stderr)
            return 1
        for swipe in parse(proc.stdout):
            print("kite-gestures: %s" % swipe, file=sys.stderr, flush=True)
            todo.put(swipe)
        proc.wait()
        time.sleep(2)            # a touchpad came or went: start again


if __name__ == "__main__":
    sys.exit(main())
