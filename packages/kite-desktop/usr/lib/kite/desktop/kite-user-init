#!/usr/bin/python3
"""Per-user KiteOS setup. Runs from /etc/X11/Xsession.d before XFCE starts.

* Desktop layout: a new account gets the KiteOS desktop (taskbar, theme and
  keyboard shortcuts) via kite-layout --first-login. Never touched again after
  that (an account still on the dropped mac layout gets it once more).
* Wallpaper: every connected monitor that has no wallpaper yet gets the
  KiteOS one (xfdesktop stores it per connector name, e.g. eDP-1, HDMI-1).
* Accent colour (once, kite-desktop 1.4.5): the taskbar marks, the
  taskbar's window pop-up and the clock's calendar follow the theme's
  accent (kite-accent) instead of a fixed blue and grey.
* Start menu (once, kite-desktop 1.4.3): an account with the Whisker menu on
  its taskbar gets KiteOS Start (kite-start) in its place, on the same
  button, and the Search key opens it. Whisker's favourites are saved for
  kite-start's first run, which puts them first in All apps, in order.
"""
import glob
import os
import re
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

WALLPAPER = "/usr/share/backgrounds/kite/bloom.jpg"
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
CHANNEL_DIR = os.path.join(CONFIG, "xfce4/xfconf/xfce-perchannel-xml")
PANEL_DIR = os.path.join(CONFIG, "xfce4/panel")
KITE_DIR = os.path.join(CONFIG, "kite")
START_DONE = os.path.join(KITE_DIR, "start-menu")
ACCENT_DONE = os.path.join(KITE_DIR, "accent-setup")
START_LAUNCHER = os.path.join(os.environ.get("KITE_LAYOUT_DATA", "/usr/share/kite/layouts"),
                              "desktop/.config/xfce4/panel/launcher-1/start.desktop")

def connected_outputs():
    try:
        out = subprocess.run(["xrandr", "--query"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return [line.split()[0] for line in out.splitlines() if " connected" in line]


def child(parent, name, typ="empty", value=None):
    for p in parent.findall("./property"):
        if p.get("name") == name:
            return p, False
    attrs = {"name": name, "type": typ}
    if value is not None:
        attrs["value"] = value
    return ET.SubElement(parent, "property", attrs), True


def setup_wallpaper():
    outputs = connected_outputs()
    if not outputs:
        return
    path = os.path.join(CHANNEL_DIR, "xfce4-desktop.xml")
    if os.path.exists(path):
        tree = ET.parse(path)
        root = tree.getroot()
    else:
        root = ET.Element("channel", name="xfce4-desktop", version="1.0")
        tree = ET.ElementTree(root)
    backdrop, _ = child(root, "backdrop")
    screen0, _ = child(backdrop, "screen0")
    changed = False
    for out in outputs:
        mon, _ = child(screen0, "monitor" + out)
        ws, _ = child(mon, "workspace0")
        _, new = child(ws, "last-image", "string", WALLPAPER)
        changed |= new
        _, new = child(ws, "image-style", "int", "5")
        changed |= new
    if changed:
        os.makedirs(CHANNEL_DIR, exist_ok=True)
        tree.write(path, encoding="UTF-8", xml_declaration=True)


def whisker_rc_favourites(plugin_id):
    """Favourites still in whiskermenu-N.rc (Whisker moves them to xfconf the
    first time it runs)."""
    try:
        with open(os.path.join(PANEL_DIR, "whiskermenu-%s.rc" % plugin_id)) as f:
            for line in f:
                if line.startswith("favorites="):
                    return [v for v in line.strip().split("=", 1)[1].split(",") if v]
    except OSError:
        pass
    return []


def setup_start_menu():
    """Swap the Whisker menu on the taskbar for kite-start, once."""
    if os.path.exists(START_DONE):
        return
    # A settings store (xfconfd) left from an earlier session would keep the
    # old panel in memory and write it back over the change: stop it first
    # (it starts again on demand, and writes its files as it exits).
    uid = str(os.getuid())
    if subprocess.run(["pgrep", "-u", uid, "-x", "xfconfd"], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL, timeout=5).returncode == 0:
        subprocess.run(["pkill", "-u", uid, "-x", "xfconfd"], timeout=5)
        for _ in range(25):
            if subprocess.run(["pgrep", "-u", uid, "-x", "xfconfd"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=5).returncode != 0:
                break
            time.sleep(0.2)
    panel = os.path.join(CHANNEL_DIR, "xfce4-panel.xml")
    changed = False
    if os.path.isfile(panel):
        tree = ET.parse(panel)
        plugins = tree.getroot().find("./property[@name='plugins']")
        for plugin in (plugins.findall("./property") if plugins is not None else []):
            if plugin.get("value") != "whiskermenu":
                continue
            pid = plugin.get("name").rsplit("-", 1)[-1]
            favs = [v.get("value") for v in plugin.findall("./property[@name='favorites']/value")]
            favs = favs or whisker_rc_favourites(pid)
            if favs and not os.path.exists(os.path.join(KITE_DIR, "start.json")):
                os.makedirs(KITE_DIR, exist_ok=True)
                with open(os.path.join(KITE_DIR, "whisker-favourites"), "w") as f:
                    f.write("".join(v + "\n" for v in favs))
            for p in list(plugin):
                plugin.remove(p)
            plugin.set("value", "launcher")
            items = ET.SubElement(plugin, "property", name="items", type="array")
            ET.SubElement(items, "value", type="string", value="start.desktop")
            ET.SubElement(plugin, "property", name="show-label", type="bool", value="false")
            folder = os.path.join(PANEL_DIR, "launcher-" + pid)
            os.makedirs(folder, exist_ok=True)
            with open(START_LAUNCHER) as src, open(os.path.join(folder, "start.desktop"), "w") as dst:
                dst.write(src.read())
            for rc in glob.glob(os.path.join(PANEL_DIR, "whiskermenu-%s.rc" % pid)):
                os.remove(rc)
            changed = True
        if changed:
            tree.write(panel, encoding="UTF-8", xml_declaration=True)
    keys = os.path.join(CHANNEL_DIR, "xfce4-keyboard-shortcuts.xml")
    if os.path.isfile(keys):
        with open(keys, encoding="utf-8") as f:
            text = f.read()
        new = re.sub(r'value="xfce4-popup-whiskermenu[^"]*"', 'value="kite-start"', text)
        if new != text:
            with open(keys, "w", encoding="utf-8") as f:
                f.write(new)
    os.makedirs(KITE_DIR, exist_ok=True)
    with open(START_DONE, "w") as f:
        f.write("kite-start\n")


def setup_accent():
    """Point the taskbar marks and the calendar at the theme's accent, once."""
    if os.path.exists(ACCENT_DONE):
        return
    for rc in glob.glob(os.path.join(PANEL_DIR, "docklike-*.rc")):
        with open(rc, encoding="utf-8") as f:
            text = f.read()
        new = text.replace("indicatorColorFromTheme=false", "indicatorColorFromTheme=true")
        if new != text:
            with open(rc, "w", encoding="utf-8") as f:
                f.write(new)
    css = os.path.join(CONFIG, "gtk-3.0", "gtk.css")
    try:
        with open(css, encoding="utf-8") as f:
            text = f.read()
        if "Clock calendar pop-up" in text:      # the KiteOS layout's file
            new = text.replace("#0067c0", "@theme_selected_bg_color").replace(
                "  background-color: #ececec;\n",
                "  background-color: mix(#ececec, @theme_selected_bg_color, 0.05);   /* the accent tint */\n")
            if new != text:
                with open(css, "w", encoding="utf-8") as f:
                    f.write(new)
    except OSError:
        pass
    os.makedirs(KITE_DIR, exist_ok=True)
    with open(ACCENT_DONE, "w") as f:
        f.write("theme accent\n")


def setup_layout():
    subprocess.run(["kite-layout", "--first-login"], timeout=30)


def main():
    for step in (setup_layout, setup_start_menu, setup_accent, setup_wallpaper):
        try:
            step()
        except Exception as exc:  # never block the login
            print(f"kite-user-init: {step.__name__}: {exc}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
