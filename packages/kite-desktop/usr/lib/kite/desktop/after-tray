#!/bin/sh
# Start a tray app only once the panel's status area is ready. Otherwise apps
# like nm-applet fall back to an old-style icon AND add a new one (two icons).
#   after-tray COMMAND [ARGS...]
i=0
while [ $i -lt 40 ]; do
    if busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1; then
        break
    fi
    sleep 0.5
    i=$((i + 1))
done
exec "$@"
