FOLDER_PREVIEW = 4      # a folder's icon always shows a 2x2 grid, empty cells included
MINI = 17               # px of each icon in that grid
HOLD_OPEN_MS = 700      # an app held over a folder this long opens it
BAR_HIDE_MS = 600       # the scroll bar fades this long after scrolling stops
SEARCH_HINT = "Search apps and settings"
FOLDER_COLUMNS = 4      # an open folder shows 4 x 3 apps, then scrolls
FOLDER_SPACING = (8, 14)  # px between rows, columns of apps in an open folder
