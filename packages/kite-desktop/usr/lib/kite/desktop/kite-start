#!/usr/bin/python3 -I
"""KiteOS Start: a Start menu that is an app drawer.

Pops up above the Start button: a search box, your apps and folders in the
order you arranged them, and your name with the power button at the bottom.
Drag an app onto the middle of another tile to make (or fill) a folder, onto
its left or right edge to move it there. Settings panels and system tools
start in the Settings and System folders; new apps of those kinds join them,
any other new app goes at the end. Nothing is ever re-sorted.

It starts hidden at login (kite-start --background, from autostart) and
stays in memory, so the Start button and the Search key show it at once;
running kite-start again while it is open hides it.

    kite-start                show it (hide it if it is open)
    kite-start --background   start it hidden

/usr/bin/kite-start is a small shell script: it asks the copy in memory over
D-Bus (the "toggle" action), and starts this program only when none runs.

Your arrangement lives in ~/.config/kite/start.json.
"""
import json
import os
import sys

CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                      "kite", "start.json")
APP_ID = "org.kiteos.Start"
# Whisker's favourites, saved here by kite-user-init when it swaps the Whisker
# menu on the taskbar for kite-start (before kite-start's first run).
SAVED_FAVOURITES = os.path.join(os.path.dirname(CONFIG), "whisker-favourites")
# A click on the Start button (or the Search key) that takes the focus away
# from the open drawer hides it; the same click then asks for it again, which
# must not show it straight back: asked within this long, it stays hidden.
REOPEN_S = 0.5
# App icons drawn once at each size and kept as PNGs: drawing ~40 SVG icons
# took half a second of every opening on the N4020.
ICON_CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                          "kite-start", "icons")
COLUMNS = 5
WIDTH, HEIGHT = 580, 600
POWER = [
    ("Lock", ["xflock4"]),
    ("Sleep", ["systemctl", "suspend"]),
    ("Hibernate", ["systemctl", "hibernate"]),
    ("Restart", ["systemctl", "reboot"]),
    ("Shut down", ["systemctl", "poweroff"]),
    ("Sign out", ["xfce4-session-logout", "--logout", "--fast"]),
]
FOLDERS = ("Settings", "System")          # first-run folders, in this order
HIDDEN_EXEC = {"picom", "xfce4-session-logout", "xfce4-appfinder", "kite-start"}
SETTINGS_EXEC = {"kite-bluetooth"}         # system-category apps that are really settings
# First run with no Whisker favourites to take over (a fresh install): the
# favourites Whisker started with on KiteOS (kite-layout), installed ones only.
DEFAULT_FAVOURITES = ("kite-install", "brave-browser", "onlyoffice-desktopeditors", "code", "thunar",
                      "xfce4-terminal", "org.xfce.mousepad", "mousepad", "org.xfce.ristretto",
                      "ristretto", "kite-apps", "kite-settings")
RECENT_KEEP = 10


# ----------------------------------------------------------------- model --

def classify(app):
    """'hidden', 'settings', 'system' or 'app' (yours: stays loose)."""
    cats = set(app["categories"])
    exe = os.path.basename(app.get("exec") or "")
    if exe in HIDDEN_EXEC or "Screensaver" in cats:
        return "hidden"
    if "PackageManager" in cats:
        return "app"                       # App Centre is how you get apps
    if exe in SETTINGS_EXEC or cats & {"Settings", "X-XFCE-SettingsDialog", "DesktopSettings", "HardwareSettings"}:
        return "settings"
    if cats & {"Development", "IDE", "WebBrowser", "Office", "Player", "Graphics", "Game"}:
        return "app"
    if cats & {"System", "Utility", "Monitor", "TerminalEmulator", "Core", "Archiving", "Mixer", "TextEditor"}:
        return "system"
    return "app"


def visible(apps):
    return [a for a in apps if classify(a) != "hidden"]


def fkey(name):
    return "folder:" + name


def load_config(path=CONFIG):
    try:
        with open(path) as f:
            data = json.load(f)
        if isinstance(data.get("order"), list) and isinstance(data.get("folders"), dict):
            return data
    except (OSError, ValueError, AttributeError):
        pass
    return None


def save_config(data, path=CONFIG):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, path)


def sync_config(cfg, apps, favourites=None):
    """Bring the arrangement up to date with the installed apps: new apps are
    placed (settings and system ones in their folder, the rest at the end),
    removed ones dropped, one-app folders dissolved. Never re-sorts.
    First run: FAVOURITES (Whisker's, in its order; else KiteOS's defaults)
    come first, then your other apps, then the Settings and System folders;
    a favourite that is a settings or system app is only in All apps, not
    also in its folder."""
    shown = visible(apps)
    ids = [a["id"] for a in shown]
    kind = {a["id"]: classify(a) for a in shown}
    if cfg is None:
        if favourites is None:
            favourites = [f + ".desktop" for f in DEFAULT_FAVOURITES]
        have = set(ids)
        first = []
        for f in favourites:
            if f in have and f not in first:
                first.append(f)
        loose = sorted((a for a in shown if kind[a["id"]] == "app" and a["id"] not in first),
                       key=lambda a: a["name"].lower())
        folders = {}
        for name, k in zip(FOLDERS, ("settings", "system")):
            members = sorted((a for a in shown if kind[a["id"]] == k and a["id"] not in first),
                             key=lambda a: a["name"].lower())
            if members:
                folders[name] = [a["id"] for a in members]
        cfg = {"order": first + [a["id"] for a in loose] + [fkey(n) for n in folders],
               "folders": folders, "known": ids, "recent": []}
        return tidy(cfg)
    order = list(cfg.get("order", []))
    folders = {n: list(v) for n, v in cfg.get("folders", {}).items()}
    known = set(cfg.get("known", []))
    placed = {i for v in folders.values() for i in v} | {k for k in order if not k.startswith("folder:")}
    for i in ids:
        if i in placed:
            continue
        target = {"settings": "Settings", "system": "System"}.get(kind[i]) if i not in known else None
        if target and target in folders:
            folders[target].append(i)
        else:
            order.append(i)
    live = set(ids)
    order = [k for k in order if (k.startswith("folder:") and k[7:] in folders) or k in live]
    folders = {n: [i for i in v if i in live] for n, v in folders.items()}
    for n in folders:
        if fkey(n) not in order:
            order.append(fkey(n))
    return tidy({"order": order, "folders": folders, "known": sorted(known | live),
                 "recent": [i for i in cfg.get("recent", []) if i in live]})


def tidy(cfg):
    """A folder with one app left becomes that app, in the folder's place;
    an empty one goes."""
    order, folders = list(cfg["order"]), dict(cfg["folders"])
    for name in list(folders):
        members = folders[name]
        if len(members) >= 2:
            continue
        pos = order.index(fkey(name)) if fkey(name) in order else len(order)
        if fkey(name) in order:
            order.remove(fkey(name))
        if members:
            order.insert(pos, members[0])
        del folders[name]
    return dict(cfg, order=order, folders=folders)


def grid(apps, cfg):
    """The drawer in your order: ('folder', name) or ('app', id)."""
    have = {a["id"] for a in apps}
    out = []
    for k in cfg["order"]:
        if k.startswith("folder:") and k[7:] in cfg["folders"]:
            out.append(("folder", k[7:]))
        elif k in have:
            out.append(("app", k))
    return out


def move_item(seq, key, target, after):
    """KEY moved next to TARGET (before it, or AFTER it)."""
    out = [k for k in seq if k != key]
    if target not in out:
        return out + [key]
    pos = out.index(target) + (1 if after else 0)
    return out[:pos] + [key] + out[pos:]


def new_folder_name(folders, base="Folder"):
    if base not in folders:
        return base
    n = 2
    while "%s %d" % (base, n) in folders:
        n += 1
    return "%s %d" % (base, n)


def make_folder(cfg, app_id, target_id):
    """APP_ID dropped on TARGET_ID: a new folder with both, where the target was."""
    folders = {n: [i for i in v if i != app_id] for n, v in cfg["folders"].items()}
    name = new_folder_name(folders)
    order = [k for k in cfg["order"] if k != app_id]
    pos = order.index(target_id) if target_id in order else len(order)
    order = [k for k in order if k != target_id]
    order.insert(pos, fkey(name))
    folders[name] = [target_id, app_id]
    return tidy(dict(cfg, order=order, folders=folders))


def add_to_folder(cfg, name, app_id):
    folders = {n: [i for i in v if i != app_id] for n, v in cfg["folders"].items()}
    order = [k for k in cfg["order"] if k != app_id]
    folders.setdefault(name, []).append(app_id)
    if fkey(name) not in order:
        order.append(fkey(name))
    return tidy(dict(cfg, order=order, folders=folders))


def remove_from_folder(cfg, name, app_id):
    """The app leaves the folder and goes right after it in the drawer."""
    folders = dict(cfg["folders"])
    folders[name] = [i for i in folders.get(name, []) if i != app_id]
    order = list(cfg["order"])
    if app_id not in order:              # already loose as well: no second copy
        pos = order.index(fkey(name)) + 1 if fkey(name) in order else len(order)
        order.insert(pos, app_id)
    return dict(cfg, order=order, folders=folders)


def commit_drop(cfg, src, src_folder, dest_folder, live):
    """SRC was dropped in DEST_FOLDER (None: All apps), whose order is now
    LIVE (SRC at its new place). It leaves SRC_FOLDER (None: All apps) when
    it came from elsewhere."""
    order = [k for k in cfg["order"]]
    folders = {n: list(v) for n, v in cfg["folders"].items()}
    if dest_folder is None:
        for n in folders:
            folders[n] = [i for i in folders[n] if i != src]
        known = set(order) | {src}
        order = [k for k in live if k in known]
    else:
        order = [k for k in order if k != src]
        for n in folders:
            if n != dest_folder:
                folders[n] = [i for i in folders[n] if i != src]
        members = set(folders.get(dest_folder, [])) | {src}
        folders[dest_folder] = [i for i in live if i in members]
    return tidy(dict(cfg, order=order, folders=folders))


def record_use(cfg, app_id):
    """APP_ID was just opened: first in the recently used list."""
    recent = [app_id] + [i for i in cfg.get("recent", []) if i != app_id]
    return dict(cfg, recent=recent[:RECENT_KEEP])


def recent_row(cfg, installed, n=COLUMNS):
    """The recently used row: the last N apps opened that are still installed."""
    return [i for i in cfg.get("recent", []) if i in installed][:n]


def parse_xfconf_array(text):
    """xfconf-query's printout of an array: its values, one per line."""
    lines = text.splitlines()
    if lines and lines[0].startswith("Value is an array"):
        lines = lines[1:]
    return [l.strip() for l in lines if l.strip()]


def saved_favourites(path=SAVED_FAVOURITES):
    """The Whisker favourites kite-user-init saved, or None."""
    try:
        with open(path) as f:
            return [line.strip() for line in f if line.strip()]
    except OSError:
        return None


def whisker_favourites():
    """The favourites of the Whisker menu on the panel (xfconf), or None."""
    import subprocess
    run = lambda *a: subprocess.run(["xfconf-query", "-c", "xfce4-panel"] + list(a),
                                    capture_output=True, text=True, timeout=3)
    try:
        props = run("-l").stdout.split()
        for prop in props:
            if prop.count("/") == 2 and prop.startswith("/plugins/plugin-") \
                    and run("-p", prop).stdout.strip() == "whiskermenu":
                fav = run("-p", prop + "/favorites")
                if fav.returncode == 0:
                    return parse_xfconf_array(fav.stdout)
    except (OSError, subprocess.SubprocessError):
        pass
    return None


def search(apps, query, settings_ids):
    """(best matches, settings) for QUERY: name starts with it, then a word of
    the name does, then the name contains it, then keywords or command."""
    q = query.strip().lower()
    if not q:
        return [], []
    ranked = []
    for a in apps:
        name = a["name"].lower()
        if name.startswith(q):
            rank = 0
        elif any(w.startswith(q) for w in name.replace("-", " ").split()):
            rank = 1
        elif q in name:
            rank = 2
        elif q in " ".join([a.get("generic", ""), " ".join(a.get("keywords", [])), a.get("exec", "")]).lower():
            rank = 3
        else:
            continue
        ranked.append((rank, name, a["id"]))
    ids = [i for _, _, i in sorted(ranked)]
    return [i for i in ids if i not in settings_ids], [i for i in ids if i in settings_ids]


