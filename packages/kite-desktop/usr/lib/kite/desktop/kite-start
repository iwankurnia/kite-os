def main():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("GdkX11", "3.0")
    from gi.repository import Gdk, GdkPixbuf, GdkX11, Gio, GLib, Gtk
    import cairo
    import hashlib
    import time

    def cached_icon(theme, gicon, size, scale):
        """GICON drawn at SIZE (x SCALE), from ICON_CACHE when the icon file
        is no newer than the cached copy; None if the theme has no such icon."""
        info = theme.lookup_by_gicon_for_scale(gicon, size, scale, Gtk.IconLookupFlags.FORCE_SIZE)
        if info is None:
            return None
        src = info.get_filename()
        path = None
        if src:
            key = hashlib.sha1(("%s|%d|%d" % (src, size, scale)).encode()).hexdigest()
            path = os.path.join(ICON_CACHE, key + ".png")
            try:
                if os.path.getmtime(path) >= os.path.getmtime(src):
                    return GdkPixbuf.Pixbuf.new_from_file(path)
            except (OSError, GLib.Error):
                pass
        try:
            pb = info.load_icon()
        except GLib.Error:
            return None
        if path is not None:
            try:
                os.makedirs(ICON_CACHE, exist_ok=True)
                pb.savev(path + ".tmp", "png", [], [])
                os.replace(path + ".tmp", path)
            except (OSError, GLib.Error):
                pass
        return pb

    def load_apps():
        apps, seen = [], set()
        for info in Gio.AppInfo.get_all():
            if not info.should_show() or not isinstance(info, Gio.DesktopAppInfo):
                continue
            aid = info.get_id()
            if aid in seen:
                continue
            seen.add(aid)
            apps.append({"id": aid, "name": info.get_display_name() or info.get_name(),
                         "generic": info.get_generic_name() or "",
                         "keywords": list(info.get_keywords() or []),
                         "categories": [c for c in (info.get_categories() or "").split(";") if c],
                         "exec": info.get_executable() or "", "info": info})
        return apps

    css = Gtk.CssProvider()
    css.load_from_data(b"""
    .kite-start { background: @theme_bg_color; }    /* Fluent's grey, with the accent tint */
    .kite-start .search { border-radius: 18px; min-height: 34px; padding: 0 14px; background: #ffffff; }
    .kite-start .search-head { background: rgba(0, 0, 0, 0.035); border-bottom: 1px solid rgba(0, 0, 0, 0.08); }
    .kite-start .hint { color: alpha(#1b1b1b, 0.55); }
    .kite-start .tile { border-radius: 8px; padding: 10px 4px 8px; }
    .kite-start flowboxchild { padding: 0; background: none; outline: none; }
    .kite-start .tile.hover { background: rgba(0, 0, 0, 0.06); }
    .kite-start flowboxchild:selected .tile, .kite-start flowboxchild:focus .tile { background: alpha(@theme_selected_bg_color, 0.12); }
    .kite-start .tile label { font-size: 9pt; color: #1b1b1b; }
    .kite-start .tile.dragged { opacity: 0.25; }
    .kite-start .tile.ghost { opacity: 0.45; }
    .kite-start .tile.drop-into { background: alpha(@theme_selected_bg_color, 0.18); }
    .kite-start .folder-icon { background: rgba(0, 0, 0, 0.07); border-radius: 12px; padding: 4px; }
    .kite-start .heading { font-weight: 600; font-size: 12pt; color: #1b1b1b; }
    .kite-start .dim { background: rgba(255, 255, 255, 0.6); }
    /* An open folder: a solid white panel over the washed-out drawer. */
    .kite-folder { background: #ffffff; }
    /* With a compositor the folder window is clear round a white card that
       draws its own soft shadow: picom's is one strength for every window. */
    .kite-folder.clear { background: transparent; }
    .kite-folder .folder-head { background: rgba(0, 0, 0, 0.035); border-bottom: 1px solid rgba(0, 0, 0, 0.08); }
    .kite-folder.clear .folder-head { border-radius: 20px 20px 0 0; }
    .kite-folder.clear .card { background: #ffffff; border-radius: 20px;
                               box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14), 0 0 0 1px rgba(0, 0, 0, 0.05); }
    .kite-folder .tile { border-radius: 8px; padding: 10px 4px 8px; }
    .kite-folder flowboxchild { padding: 0; background: none; outline: none; }
    .kite-folder .tile.hover { background: rgba(0, 0, 0, 0.05); }
    .kite-folder .tile label { font-size: 9pt; color: #1b1b1b; }
    .kite-folder flowboxchild:selected .tile, .kite-folder flowboxchild:focus .tile { background: rgba(0, 0, 0, 0.07); }
    .kite-folder .tile.dragged { opacity: 0.25; }
    .kite-folder .tile.ghost { opacity: 0.45; }
    .kite-folder .folder-title { font-weight: 600; font-size: 12pt; background: none; border: none;
                                 box-shadow: none; color: #1b1b1b; caret-color: @theme_selected_bg_color; }
    /* Thin scroll bars: a 4 px rounded slider on a clear track. */
    .kite-start scrollbar, .kite-folder scrollbar,
    .kite-start scrollbar trough, .kite-folder scrollbar trough { background: none; border: none; }
    .kite-start scrollbar slider, .kite-folder scrollbar slider {
        min-width: 4px; min-height: 24px; border: none; border-radius: 2px; margin: 2px;
        background: rgba(0, 0, 0, 0.25); }
    .kite-start scrollbar slider:hover, .kite-folder scrollbar slider:hover { background: rgba(0, 0, 0, 0.4); }
    .kite-start .folder-title { font-weight: 600; font-size: 12pt; background: none; border: none;
                                box-shadow: none; }
    .kite-start .footer { background: rgba(0, 0, 0, 0.035); border-top: 1px solid rgba(0, 0, 0, 0.08);
                          border-radius: 0 0 10px 10px; padding: 10px 18px; }
