<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Task Manager's "Run as administrator": kite-tasks through pkexec, with a
     window (allow_gui keeps DISPLAY and XAUTHORITY). -->
<policyconfig>
  <vendor>KiteOS</vendor>
  <action id="org.kiteos.tasks">
    <description>Run Task Manager as administrator</description>
    <message>Running Task Manager as administrator needs your password</message>
    <icon_name>utilities-system-monitor</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/kite-tasks</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
