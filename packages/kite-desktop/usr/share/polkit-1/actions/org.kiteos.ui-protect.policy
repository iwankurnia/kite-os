<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- kite-ui-protect: keeps the session's window manager and compositor in
     memory (a protected systemd scope). Started at login, so no password for
     the person at the laptop; nobody else may. -->
<policyconfig>
  <vendor>KiteOS</vendor>
  <action id="org.kiteos.ui-protect">
    <description>Keep the desktop in memory</description>
    <message>Keeping the desktop in memory needs your password</message>
    <icon_name>preferences-desktop</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kite/kite-ui-protect</annotate>
  </action>
</policyconfig>
