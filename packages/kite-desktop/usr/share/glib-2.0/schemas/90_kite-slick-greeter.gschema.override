[x.dm.slick-greeter]
background='/usr/share/backgrounds/kite/login-frosted.jpg'
background-color='#e8ecf4'
draw-user-backgrounds=false
draw-grid=false
show-hostname=false
show-a11y=false
show-keyboard=false
show-clock=true
show-power=true
show-quit=true
logo='/usr/share/kite/greeter-logo.png'
theme-name='Fluent-Light'
icon-theme-name='Papirus-Light'
font-name='Inter 11'
xft-antialias=true
xft-hintstyle='hintslight'
xft-rgba='rgb'
clock-format='%H:%M'
