[user]
# Pinned apps are filled in by kite-layout from what is installed.
pinned=@PINNED@
iconSize=24
forceIconSize=true
showPreviews=true
# Previews 120 px high, as wide as the window's shape gives (at least 160,
# at most 264 px), each tile as wide as its preview, as on Windows 11.
# previewHeight is KiteOS's patch to docklike (patches/xfce4-docklike-plugin);
# previewScale is used only by an unpatched docklike.
previewHeight=120
previewScale=0.2
showWindowCount=false
# The window pop-up also for an app with one window (as on Windows 11)
noWindowsListIfSingle=false
onlyDisplayVisible=false
onlyDisplayScreen=false
indicatorStyle=0
inactiveIndicatorStyle=0
# The running app's mark in the theme's accent colour (kite-accent, from the
# wallpaper; KiteOS's patch 05), the others grey.
indicatorColorFromTheme=true
indicatorColor=rgb(0,103,192)
inactiveColor=rgb(134,134,134)
indicatorOrientation=0
keyComboActive=true
keyAloneActive=false
middleButtonBehavior=0
