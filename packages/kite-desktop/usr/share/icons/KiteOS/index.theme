[Icon Theme]
Name=KiteOS
Comment=KiteOS status and drive icons; used under the layout tray packs (KiteOS-Tray-*) to fill their gaps
Directories=scalable/status,scalable/devices

[scalable/status]
Size=24
MinSize=8
MaxSize=512
Type=Scalable
Context=Status

# Drives: Papirus's dark 16 px drive icon under every name udisks/gvfs give the
# Chromebook's eMMC, SD and USB drives. Without these, Thunar's sidebar showed
# a pale or invisible icon (GTK fell through to other themes' large icons).
[scalable/devices]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Devices
