/* KiteOS app launcher: a menu card at the bottom left, above the shelf's
   launcher button. Opened by the Search key; a click outside closes it. */
configuration {
    show-icons:            true;
    icon-theme:            "Papirus";
    /* Apps only: the individual settings dialogs live inside Settings. */
    drun-categories:       "AudioVideo,Audio,Video,Development,Education,Game,Graphics,Network,Office,Science,Utility,System";
    drun-display-format:   "{name}";
    display-drun:          "";
    disable-history:       false;
    sort:                  true;
    sorting-method:        "fzf";
    matching:              "fuzzy";
    hover-select:          true;
    me-select-entry:       "";
    me-accept-entry:       "MousePrimary";
    kb-cancel:             "Escape,Super+space";
}

* {
    font:                  "Roboto 11";
    /* Light theme (ChromeOS/Google light palette). */
    bg:                    rgba(248, 249, 250, 0.97);
    fg:                    #202124;
    dim:                   #5f6368;
    accent:                #1a73e8;
    tile:                  rgba(32, 33, 36, 0.07);
    background-color:      transparent;
    text-color:            @fg;
}

/* The menu card: 560 px wide, 12 px from the screen's left edge and 12 px
   above the 44 px shelf. Its shadow and slide-up animation come from picom
   (/etc/kite/picom.conf, which rounds the shadow to the same 16 px). */
window {
    location:              south west;
    anchor:                south west;
    x-offset:              12px;
    y-offset:              -56px;
    width:                 560px;
    transparency:          "real";    /* rounded corners */
    background-color:      @bg;
    border:                1px;
    border-color:          rgba(32, 33, 36, 0.16);
    border-radius:         16px;
    padding:               20px;
}

mainbox {
    spacing:               20px;
    children:              [ inputbar, listview ];
}

inputbar {
    background-color:      #e8eaed;
    border-radius:         24px;
    padding:               12px 22px;
    margin:                0;
    spacing:               12px;
    children:              [ icon-search, entry ];
}

icon-search {
    expand:                false;
    filename:              "system-search-symbolic";
    size:                  20px;
    vertical-align:        0.5;
}

entry {
    text-color:            #202124;
    placeholder:           "Search apps";
    placeholder-color:     #5f6368;
    vertical-align:        0.5;
    cursor:                text;
}

listview {
    columns:               4;
    lines:                 5;
    fixed-columns:         true;
    fixed-height:          true;
    spacing:               14px;
    cycle:                 false;
    scrollbar:             false;
    flow:                  horizontal;
}

element {
    orientation:           vertical;
    padding:               10px 6px;
    spacing:               8px;
    border-radius:         16px;
    cursor:                pointer;
}

element selected.normal {
    background-color:      @tile;
}

element-icon {
    size:                  48px;
    horizontal-align:      0.5;
    cursor:                inherit;
}

element-text {
    horizontal-align:      0.5;
    vertical-align:        0.5;
    cursor:                inherit;
    text-color:            inherit;
}
