/* KiteOS full-screen app launcher (ChromeOS-style). Opened by the Search key. */
configuration {
    show-icons:            true;
    icon-theme:            "Papirus";
    /* Apps only: the individual settings dialogs live inside Settings. */
    drun-categories:       "AudioVideo,Audio,Video,Development,Education,Game,Graphics,Network,Office,Science,Utility,System";
    drun-display-format:   "{name}";
    display-drun:          "";
    disable-history:       false;
    sort:                  true;
    sorting-method:        "fzf";
    matching:              "fuzzy";
    hover-select:          true;
    me-select-entry:       "";
    me-accept-entry:       "MousePrimary";
    kb-cancel:             "Escape,Super+space";
}

* {
    font:                  "Roboto 11";
    bg:                    rgba(20, 24, 33, 0.82);
    fg:                    #e8eaed;
    dim:                   #9aa0a6;
    accent:                #8ab4f8;
    tile:                  rgba(255, 255, 255, 0.08);
    background-color:      transparent;
    text-color:            @fg;
}

window {
    fullscreen:            true;
    transparency:          "real";
    background-color:      @bg;
    padding:               9% 12% 6% 12%;
}

mainbox {
    spacing:               32px;
    children:              [ inputbar, listview ];
}

inputbar {
    background-color:      rgba(255, 255, 255, 0.92);
    border-radius:         24px;
    padding:               12px 22px;
    margin:                0 18%;
    spacing:               12px;
    children:              [ icon-search, entry ];
}

icon-search {
    expand:                false;
    filename:              "system-search-symbolic";
    size:                  20px;
    vertical-align:        0.5;
}

entry {
    text-color:            #202124;
    placeholder:           "Search apps";
    placeholder-color:     #5f6368;
    vertical-align:        0.5;
    cursor:                text;
}

listview {
    columns:               6;
    lines:                 3;
    fixed-columns:         true;
    fixed-height:          true;
    spacing:               14px;
    cycle:                 false;
    scrollbar:             false;
    flow:                  horizontal;
}

element {
    orientation:           vertical;
    padding:               14px 6px;
    spacing:               10px;
    border-radius:         16px;
    cursor:                pointer;
}

element selected.normal {
    background-color:      @tile;
}

element-icon {
    size:                  56px;
    horizontal-align:      0.5;
    cursor:                inherit;
}

element-text {
    horizontal-align:      0.5;
    vertical-align:        0.5;
    cursor:                inherit;
    text-color:            inherit;
}
