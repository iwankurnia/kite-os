#!/usr/bin/python3
"""Switch the KiteOS desktop layout (from docker-crd-vstunnel).

  kite-layout                 show the current and default layout
  kite-layout windows|mac     use that layout now (no logout needed)
  kite-layout --system L      make L the default for new accounts (root;
                              the installer runs this with your choice)
  kite-layout --first-login   used at login: set up a new account

windows: Fluent theme, Papirus-Light icons, a taskbar at the bottom with the
         Start menu on the left.
mac:     Qogir theme and icons, a menu bar at the top and a Dock.

Switching replaces the panel, window, theme and keyboard-shortcut settings
with the layout's; files, apps and other settings are not touched.
"""
import copy
import os
import re
import shutil
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

LAYOUTS = ("windows", "mac")
DATA = os.environ.get("KITE_LAYOUT_DATA", "/usr/share/kite/layouts")
SYSTEM_DEFAULT = os.environ.get("KITE_LAYOUT_SYSTEM", "/etc/kite/layout")
THEMES = os.environ.get("KITE_THEMES_DIR", "/usr/share/themes")
APPS = os.environ.get("KITE_APPS_DIR", "/usr/share/applications")
HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
CHANNELS = os.path.join(CONFIG, "xfce4/xfconf/xfce-perchannel-xml")
STATE = os.path.join(CONFIG, "kite/layout")

GTK_THEME = {"windows": "Fluent-Light", "mac": "Qogir-Light"}
FALLBACK_THEME = "Orchis-Light-Compact"     # if the theme is missing
ICON_THEME = {"windows": "KiteOS-Tray-Windows", "mac": "KiteOS-Tray-Mac"}
DECORATION = {"windows": "menu:minimize,maximize,close", "mac": "close,minimize,maximize:menu"}
# Pinned apps, in order; only the installed ones are pinned. "Install KiteOS"
# exists only in the live session.
PINNED = ("kite-install", "brave-browser", "onlyoffice-desktopeditors", "thunar", "xfce4-terminal",
          "kite-app-centre", "kite-apps", "xfce-settings-manager")

# Files a layout owns (relative to ~/.config); removed before the layout's own
# copies go in, so nothing of the other layout is left behind.
OWNED = ("xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml",
         "xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml",
         "xfce4/xfconf/xfce-perchannel-xml/xsettings.xml",
         "xfce4/xfconf/xfce-perchannel-xml/thunar.xml",
         "xfce4/xfconf/xfce-perchannel-xml/xfce4-terminal.xml",
         "xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml",
         "xfce4/panel", "gtk-3.0/gtk.css")

# Keyboard shortcuts on top of XFCE's defaults. The Chromebook's Search key
# tap arrives as Super+Space and its overview key as Super+W (keyd).
SHORTCUTS = {
    "common": {
        "commands": {
            "<Super>space": "xfce4-popup-whiskermenu",
            "<Super>w": "xfdesktop --windowlist",
            "<Super>l": "xflock4",
            "<Super>e": "thunar",
            "<Super>r": "xfce4-appfinder --collapsed",
            "<Primary><Alt>t": "exo-open --launch TerminalEmulator",
            "<Primary><Shift>Escape": "xfce4-taskmanager",
        },
        "xfwm4": {},
    },
    "windows": {
        "commands": {},
        "xfwm4": {"<Super>d": "show_desktop_key", "<Super>Up": "maximize_window_key",
                  "<Super>Left": "tile_left_key", "<Super>Right": "tile_right_key"},
    },
    "mac": {
        "commands": {"<Super>Return": "exo-open --launch TerminalEmulator"},
        "xfwm4": {"<Super>q": "close_window_key", "<Super>m": "hide_window_key",
                  "<Super>Tab": "cycle_windows_key"},
    },
}


def read_layout(path):
    try:
        with open(path) as f:
            value = f.read().strip()
        return value if value in LAYOUTS else None
    except OSError:
        return None


def system_default():
    return read_layout(SYSTEM_DEFAULT) or "windows"


def placeholders(layout):
    theme = GTK_THEME[layout]
    if not os.path.isdir(os.path.join(THEMES, theme, "gtk-3.0")):
        theme = FALLBACK_THEME
    pinned = "".join(os.path.join(APPS, a + ".desktop") + ";" for a in PINNED
                     if os.path.isfile(os.path.join(APPS, a + ".desktop")))
    return {"@GTK_THEME@": theme, "@ICON_THEME@": ICON_THEME[layout],
            "@DECORATION_LAYOUT@": DECORATION[layout], "@PINNED@": pinned}, theme


def system_file(name):
    dirs = os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":") + ["/etc/xdg"]
    for d in dirs:
        p = os.path.join(d, "xfce4/xfconf/xfce-perchannel-xml", name)
        if os.path.isfile(p):
            return p
    return None


def write_shortcuts(layout):
    """XFCE honours custom shortcuts only as a complete list: start from the
    installed XFCE's defaults and add KiteOS's and the layout's bindings."""
    src = system_file("xfce4-keyboard-shortcuts.xml")
    if not src:
        return
    tree = ET.parse(src)
    root = tree.getroot()
    for section in ("commands", "xfwm4"):
        sec = root.find(f"./property[@name='{section}']")
        if sec is None:
            continue
        default = sec.find("./property[@name='default']")
        if default is None:
            continue
        for old in sec.findall("./property[@name='custom']"):
            sec.remove(old)
        custom = copy.deepcopy(default)
        custom.set("name", "custom")
        extra = dict(SHORTCUTS["common"][section])
        extra.update(SHORTCUTS[layout][section])
        for key, cmd in extra.items():
            for p in custom.findall("./property"):
                if p.get("name") == key:
                    custom.remove(p)
            ET.SubElement(custom, "property", name=key, type="string", value=cmd)
        ET.SubElement(custom, "property", name="override", type="bool", value="true")
        sec.append(custom)
    os.makedirs(CHANNELS, exist_ok=True)
    tree.write(os.path.join(CHANNELS, "xfce4-keyboard-shortcuts.xml"),
               encoding="UTF-8", xml_declaration=True)


def copy_tree(src, dst, subs):
    for base, _dirs, files in os.walk(src):
        rel = os.path.relpath(base, src)
        os.makedirs(os.path.join(dst, rel), exist_ok=True)
        for name in files:
            with open(os.path.join(base, name), encoding="utf-8") as f:
                text = f.read()
            for k, v in subs.items():
                text = text.replace(k, v)
            with open(os.path.join(dst, rel, name), "w", encoding="utf-8") as f:
                f.write(text)


def write_layout(layout):
    """Write the layout's files into ~/.config. Returns the GTK theme used."""
    for rel in OWNED:
        p = os.path.join(CONFIG, rel)
        if os.path.isdir(p) and not os.path.islink(p):
            shutil.rmtree(p)
        elif os.path.lexists(p):
            os.remove(p)
    subs, theme = placeholders(layout)
    copy_tree(os.path.join(DATA, "common", ".config"), CONFIG, subs)
    copy_tree(os.path.join(DATA, layout, ".config"), CONFIG, subs)
    write_shortcuts(layout)
    # The window theme follows the GTK theme (Default when it has none).
    xfwm = os.path.join(CHANNELS, "xfwm4.xml")
    if os.path.isfile(xfwm) and not os.path.isdir(os.path.join(THEMES, theme, "xfwm4")):
        with open(xfwm) as f:
            text = f.read()
        with open(xfwm, "w") as f:
            f.write(re.sub(r'(name="theme" type="string" value=")[^"]*', r"\1Default", text))
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        f.write(layout + "\n")
    return theme


def run(*cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
    except (OSError, subprocess.SubprocessError):
        pass


def spawn(*cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def switch_live(layout):
    """Apply in a running session: the settings store (xfconfd) caches the
    files, so stop it and the panel, write, then restart what reads them."""
    run("xfce4-panel", "--quit")
    run("pkill", "-u", str(os.getuid()), "-x", "xfconfd")
    time.sleep(1)
    write_layout(layout)
    spawn("xfsettingsd", "--replace")
    spawn("xfwm4", "--replace")
    time.sleep(1)
    spawn("xfce4-panel")
    run("xfdesktop", "--reload")


def main(args):
    if not args:
        print("layout: %s (default for new accounts: %s)" % (read_layout(STATE) or "not set", system_default()))
        return 0
    if args[0] == "--system" and len(args) == 2 and args[1] in LAYOUTS:
        os.makedirs(os.path.dirname(SYSTEM_DEFAULT), exist_ok=True)
        with open(SYSTEM_DEFAULT, "w") as f:
            f.write(args[1] + "\n")
        print("New accounts start with the %s layout." % args[1])
        return 0
    if args == ["--first-login"]:
        if read_layout(STATE) is None:
            write_layout(system_default())
        return 0
    if len(args) == 1 and args[0] in LAYOUTS:
        if os.environ.get("DISPLAY"):
            switch_live(args[0])
        else:
            write_layout(args[0])
        print("Switched to the %s layout." % args[0])
        return 0
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
