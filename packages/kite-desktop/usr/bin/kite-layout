#!/usr/bin/python3
"""Switch the KiteOS desktop layout.

  kite-layout                 show the current and default layout
  kite-layout windows|mac     use that layout now (no logout needed)
  kite-layout keys K          window keys: chromebook, standard or auto
                              (auto: chromebook on a Chromebook)
  kite-layout --system L      make L the default for new accounts (root;
                              the installer runs this with your choice)
  kite-layout --first-login   used at login: set up a new account

windows: Fluent theme, Papirus-Light icons, a taskbar at the bottom with the
         Start menu on the left.
mac:     Qogir theme and icons, a menu bar at the top and a Dock.

Switching replaces the panel, window, theme and keyboard-shortcut settings
with the layout's; files, apps and other settings are not touched.
"""
import copy
import os
import re
import shutil
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

LAYOUTS = ("windows", "mac")
DATA = os.environ.get("KITE_LAYOUT_DATA", "/usr/share/kite/layouts")
SYSTEM_DEFAULT = os.environ.get("KITE_LAYOUT_SYSTEM", "/etc/kite/layout")
THEMES = os.environ.get("KITE_THEMES_DIR", "/usr/share/themes")
APPS = os.environ.get("KITE_APPS_DIR", "/usr/share/applications")
HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
CHANNELS = os.path.join(CONFIG, "xfce4/xfconf/xfce-perchannel-xml")
STATE = os.path.join(CONFIG, "kite/layout")
KEYS_STATE = os.path.join(CONFIG, "kite/keys")
DMI = os.environ.get("KITE_DMI_DIR", "/sys/class/dmi/id")
KEY_STYLES = ("chromebook", "standard")

GTK_THEME = {"windows": "Fluent-Light", "mac": "Qogir-Light"}
FALLBACK_THEME = "Orchis-Light-Compact"     # if the theme is missing
ICON_THEME = {"windows": "KiteOS-Tray-Windows", "mac": "KiteOS-Tray-Mac"}
DECORATION = {"windows": "menu:minimize,maximize,close", "mac": "close,minimize,maximize:menu"}
# Pinned apps, in order; only the installed ones are pinned. "Install KiteOS"
# exists only in the live session.
PINNED = ("kite-install", "brave-browser", "onlyoffice-desktopeditors", "thunar", "xfce4-terminal",
          "kite-apps", "kite-settings")
# Favourites in the Start/kite menu, so it opens with something to click; only
# the installed ones are listed (the text editor and image viewer have both
# their old and their reverse-DNS desktop file names here).
FAVOURITES = ("kite-install", "brave-browser", "onlyoffice-desktopeditors", "thunar",
              "xfce4-terminal", "org.xfce.mousepad", "mousepad", "org.xfce.ristretto",
              "ristretto", "kite-apps", "kite-settings")

# Files a layout owns (relative to ~/.config); removed before the layout's own
# copies go in, so nothing of the other layout is left behind.
OWNED = ("xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml",
         "xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml",
         "xfce4/xfconf/xfce-perchannel-xml/xsettings.xml",
         "xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml",
         "xfce4/panel", "gtk-3.0/gtk.css")

# Files the layouts share that hold the user's own settings (Files and
# Terminal preferences): written only when the account has none yet.
KEEP = ("xfce4/xfconf/xfce-perchannel-xml/thunar.xml",
        "xfce4/xfconf/xfce-perchannel-xml/xfce4-terminal.xml")
# xsettings.xml belongs to the layout (theme, icons, buttons), but the fonts
# in it are the user's: carried over a switch.
KEEP_XSETTINGS = ("FontName", "MonospaceFontName")

# Keyboard shortcuts on top of XFCE's defaults. The Chromebook's Search key
# tap arrives as Super+Space and its overview key as Super+W (keyd).
SHORTCUTS = {
    "common": {
        "commands": {
            "<Super>space": "xfce4-popup-whiskermenu",
            "<Super>w": "xfdesktop --windowlist",
            "<Super>l": "xflock4",
            "<Super>e": "thunar",
            "<Super>r": "xfce4-appfinder --collapsed",
            "<Primary><Alt>t": "exo-open --launch TerminalEmulator",
            "<Primary><Shift>Escape": "xfce4-taskmanager",
        },
    },
    "windows": {"commands": {}},
    "mac": {"commands": {"<Super>Return": "exo-open --launch TerminalEmulator"}},
}

# Window keys. xfwm4 honours ONE key per action (a second key for the same
# action is dead), so each key here replaces XFCE's default key for its action.
#   chromebook: ChromeOS's own keys, for a keyboard with no F-keys and a
#               Search key (Super): the same in both layouts.
#   standard:   the layout's look-alike keys (Windows or Mac, Super as Cmd).
WINDOW_KEYS = {
    "chromebook": {
        "common": {"<Alt>Tab": "cycle_windows_key", "<Primary><Shift>w": "close_window_key",
                   "<Alt>minus": "hide_window_key", "<Alt>equal": "maximize_window_key",
                   "<Alt>bracketleft": "tile_left_key", "<Alt>bracketright": "tile_right_key",
                   "<Super>d": "show_desktop_key"},
        "windows": {}, "mac": {},
    },
    "standard": {
        "common": {},
        "windows": {"<Super>d": "show_desktop_key", "<Super>Up": "maximize_window_key",
                    "<Super>Left": "tile_left_key", "<Super>Right": "tile_right_key"},
        "mac": {"<Super>q": "close_window_key", "<Super>m": "hide_window_key",
                "<Super>Tab": "cycle_windows_key"},
    },
}


def is_chromebook():
    for f in ("sys_vendor", "product_family"):
        try:
            with open(os.path.join(DMI, f)) as fh:
                if fh.read().strip().lower() == "google":
                    return True
        except OSError:
            pass
    return False


def key_style():
    """The user's choice (~/.config/kite/keys), else chromebook on a Chromebook."""
    try:
        with open(KEYS_STATE) as f:
            v = f.read().strip()
        if v in KEY_STYLES:
            return v
    except OSError:
        pass
    return "chromebook" if is_chromebook() else "standard"


def window_keys(layout, style):
    keys = dict(WINDOW_KEYS[style]["common"])
    keys.update(WINDOW_KEYS[style][layout])
    return keys


def read_layout(path):
    try:
        with open(path) as f:
            value = f.read().strip()
        return value if value in LAYOUTS else None
    except OSError:
        return None


def system_default():
    return read_layout(SYSTEM_DEFAULT) or "windows"


def placeholders(layout):
    theme = GTK_THEME[layout]
    if not os.path.isdir(os.path.join(THEMES, theme, "gtk-3.0")):
        theme = FALLBACK_THEME
    pinned = "".join(os.path.join(APPS, a + ".desktop") + ";" for a in PINNED
                     if os.path.isfile(os.path.join(APPS, a + ".desktop")))
    favourites = ",".join(a + ".desktop" for a in FAVOURITES
                          if os.path.isfile(os.path.join(APPS, a + ".desktop")))
    return {"@GTK_THEME@": theme, "@ICON_THEME@": ICON_THEME[layout],
            "@DECORATION_LAYOUT@": DECORATION[layout], "@PINNED@": pinned,
            "@FAVOURITES@": favourites}, theme


def system_file(name):
    dirs = os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":") + ["/etc/xdg"]
    for d in dirs:
        p = os.path.join(d, "xfce4/xfconf/xfce-perchannel-xml", name)
        if os.path.isfile(p):
            return p
    return None


def write_shortcuts(layout):
    """XFCE honours custom shortcuts only as a complete list: start from the
    installed XFCE's defaults and add KiteOS's and the layout's bindings."""
    src = system_file("xfce4-keyboard-shortcuts.xml")
    if not src:
        return
    tree = ET.parse(src)
    root = tree.getroot()
    for section in ("commands", "xfwm4"):
        sec = root.find(f"./property[@name='{section}']")
        if sec is None:
            continue
        default = sec.find("./property[@name='default']")
        if default is None:
            continue
        for old in sec.findall("./property[@name='custom']"):
            sec.remove(old)
        custom = copy.deepcopy(default)
        custom.set("name", "custom")
        if section == "commands":
            extra = dict(SHORTCUTS["common"]["commands"])
            extra.update(SHORTCUTS[layout]["commands"])
        else:
            extra = window_keys(layout, key_style())
        for key, cmd in extra.items():
            for p in custom.findall("./property"):
                # the same key, or (window keys) another key for the same action
                if p.get("name") == key or (section == "xfwm4" and p.get("value") == cmd):
                    custom.remove(p)
            ET.SubElement(custom, "property", name=key, type="string", value=cmd)
        ET.SubElement(custom, "property", name="override", type="bool", value="true")
        sec.append(custom)
    os.makedirs(CHANNELS, exist_ok=True)
    tree.write(os.path.join(CHANNELS, "xfce4-keyboard-shortcuts.xml"),
               encoding="UTF-8", xml_declaration=True)


def copy_tree(src, dst, subs):
    for base, _dirs, files in os.walk(src):
        rel = os.path.relpath(base, src)
        os.makedirs(os.path.join(dst, rel), exist_ok=True)
        for name in files:
            relname = os.path.normpath(os.path.join(rel, name))
            if relname in KEEP and os.path.exists(os.path.join(dst, relname)):
                continue
            with open(os.path.join(base, name), encoding="utf-8") as f:
                text = f.read()
            for k, v in subs.items():
                text = text.replace(k, v)
            with open(os.path.join(dst, rel, name), "w", encoding="utf-8") as f:
                f.write(text)


def write_layout(layout):
    """Write the layout's files into ~/.config. Returns the GTK theme used."""
    xsettings = os.path.join(CHANNELS, "xsettings.xml")
    fonts = {}
    try:
        for p in ET.parse(xsettings).getroot().findall("./property[@name='Gtk']/property"):
            if p.get("name") in KEEP_XSETTINGS and p.get("value"):
                fonts[p.get("name")] = p.get("value")
    except (OSError, ET.ParseError):
        pass
    for rel in OWNED:
        p = os.path.join(CONFIG, rel)
        if os.path.isdir(p) and not os.path.islink(p):
            shutil.rmtree(p)
        elif os.path.lexists(p):
            os.remove(p)
    subs, theme = placeholders(layout)
    copy_tree(os.path.join(DATA, "common", ".config"), CONFIG, subs)
    copy_tree(os.path.join(DATA, layout, ".config"), CONFIG, subs)
    write_shortcuts(layout)
    if fonts and os.path.isfile(xsettings):
        tree = ET.parse(xsettings)
        for p in tree.getroot().findall("./property[@name='Gtk']/property"):
            if p.get("name") in fonts:
                p.set("value", fonts[p.get("name")])
        tree.write(xsettings, encoding="UTF-8", xml_declaration=True)
    # The window theme follows the GTK theme (Default when it has none).
    xfwm = os.path.join(CHANNELS, "xfwm4.xml")
    if os.path.isfile(xfwm) and not os.path.isdir(os.path.join(THEMES, theme, "xfwm4")):
        with open(xfwm) as f:
            text = f.read()
        with open(xfwm, "w") as f:
            f.write(re.sub(r'(name="theme" type="string" value=")[^"]*', r"\1Default", text))
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        f.write(layout + "\n")
    return theme


LOG = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "kite-layout.log")


def _log():
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        return open(LOG, "a")
    except OSError:
        return subprocess.DEVNULL


def run(*cmd):
    out = _log()
    try:
        subprocess.run(cmd, stdout=out, stderr=out, timeout=20)
    except (OSError, subprocess.SubprocessError):
        pass


def spawn(*cmd):
    out = _log()
    try:
        subprocess.Popen(cmd, stdout=out, stderr=out, start_new_session=True)
    except OSError:
        pass


def wait_gone(name, seconds=5.0):
    """Wait until this user's NAME process has exited ("xfce4-panel --quit" and
    pkill return before it has)."""
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        try:
            r = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", name],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        except (OSError, subprocess.SubprocessError):
            return
        if r.returncode != 0:
            return
        time.sleep(0.2)


def apply_shortcuts_live():
    """Hand the written keyboard shortcuts to the running xfconfd, so xfwm4 and
    xfsettingsd pick them up now (xfconfd keeps its own copy of the file)."""
    path = os.path.join(CHANNELS, "xfce4-keyboard-shortcuts.xml")
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError):
        return
    ch = ["xfconf-query", "-c", "xfce4-keyboard-shortcuts"]
    for section in ("commands", "xfwm4"):
        custom = root.find(f"./property[@name='{section}']/property[@name='custom']")
        if custom is None:
            continue
        run(*ch, "-p", f"/{section}/custom", "-r", "-R")
        for p in custom.findall("./property"):
            typ = p.get("type", "string")
            run(*ch, "-p", f"/{section}/custom/{p.get('name')}", "-n", "-t", typ, "-s", p.get("value", ""))


def xfwm4_settings():
    """(name, type, value) of the window manager's settings in the new files."""
    try:
        root = ET.parse(os.path.join(CHANNELS, "xfwm4.xml")).getroot()
    except (OSError, ET.ParseError):
        return []
    general = root.find("./property[@name='general']")
    if general is None:
        return []
    return [(p.get("name"), p.get("type"), p.get("value")) for p in general.findall("./property")
            if p.get("type") in ("string", "int", "uint", "bool") and p.get("value") is not None]


def switch_live(layout):
    """Apply in a running session. The settings store (xfconfd) caches the
    files, so the panel is stopped, xfconfd restarted on the new files and the
    panel started again. The window manager is NOT restarted: xfce4-session
    owns it (a second "xfwm4 --replace" fights the session's respawns and can
    leave no window manager at all). Its settings are set again through
    xfconf instead, which xfwm4 applies live, like its own settings dialog."""
    # The panel saves its settings while it exits, starting xfconfd again if
    # needed; so wait for it, then stop xfconfd and wait for that too, before
    # the new files go in (otherwise the old layout can come back).
    run("xfce4-panel", "--quit")
    wait_gone("xfce4-panel")
    run("pkill", "-u", str(os.getuid()), "-x", "xfconfd")
    wait_gone("xfconfd")
    write_layout(layout)
    for name, typ, value in xfwm4_settings():
        run("xfconf-query", "-c", "xfwm4", "-p", "/general/" + name, "-n", "-t", typ, "-s", value)
    apply_shortcuts_live()
    spawn("xfsettingsd", "--replace")      # theme, icons, fonts, keyboard shortcuts
    time.sleep(1)
    spawn("xfce4-panel")
    run("xfdesktop", "--reload")


def main(args):
    if not args:
        print("layout: %s (default for new accounts: %s)" % (read_layout(STATE) or "not set", system_default()))
        return 0
    if args[0] == "--system" and len(args) == 2 and args[1] in LAYOUTS:
        if os.geteuid() != 0 and not os.environ.get("KITE_LAYOUT_SYSTEM"):
            print("kite-layout: --system changes the default for new accounts; run it with sudo.",
                  file=sys.stderr)
            return 1
        os.makedirs(os.path.dirname(SYSTEM_DEFAULT), exist_ok=True)
        with open(SYSTEM_DEFAULT, "w") as f:
            f.write(args[1] + "\n")
        print("New accounts start with the %s layout." % args[1])
        return 0
    if args and args[0] == "keys":
        if len(args) == 1:
            print("window keys: %s" % key_style())
            return 0
        if len(args) == 2 and args[1] in KEY_STYLES + ("auto",):
            if args[1] == "auto":
                try:
                    os.remove(KEYS_STATE)
                except OSError:
                    pass
            else:
                os.makedirs(os.path.dirname(KEYS_STATE), exist_ok=True)
                with open(KEYS_STATE, "w") as f:
                    f.write(args[1] + "\n")
            layout = read_layout(STATE) or system_default()
            write_shortcuts(layout)
            if os.environ.get("DISPLAY"):
                apply_shortcuts_live()
            print("Window keys: %s." % key_style())
            return 0
    if args == ["--first-login"]:
        if read_layout(STATE) is None:
            write_layout(system_default())
        return 0
    if len(args) == 1 and args[0] in LAYOUTS:
        if os.environ.get("DISPLAY"):
            switch_live(args[0])
        else:
            write_layout(args[0])
        print("Switched to the %s layout." % args[0])
        return 0
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
