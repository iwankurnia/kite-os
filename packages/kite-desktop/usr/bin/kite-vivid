#!/usr/bin/python3
"""Vivid colours for the built-in screen (like BlackBerry's "vivid" mode).

Boosts colour saturation with the display's colour matrix (DRM "CTM"), so the
graphics hardware does the work: no CPU, no compositor. Run at login from
/etc/xdg/autostart/kite-vivid.desktop.

  kite-vivid            apply the saved level (quietly does nothing if unsupported)
  kite-vivid 1.3        apply and keep 1.3x saturation (0.5 to 2.0)
  kite-vivid on | off   1.2x / normal colours
  kite-vivid status     show the level and whether the screen supports it

The level comes from ~/.config/kite/vivid.conf, else /etc/kite/display.conf.
"""
import os
import re
import subprocess
import sys

SYSTEM_CONF = "/etc/kite/display.conf"
DEFAULT_ON = 1.2
LUMA = (0.2126, 0.7152, 0.0722)    # Rec. 709: greys stay grey
INTERNAL = re.compile(r"^(eDP|LVDS|DSI)")


def user_conf():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "kite", "vivid.conf")


def ctm(level):
    """The 3x3 saturation matrix as xrandr's CTM value: nine decimal numbers,
    row by row. xrandr (1.5.1+, Debian 13) encodes them to the kernel's S31.32
    format itself; giving it pre-encoded integers turns the screen white."""
    return ",".join("%.6f" % (level * (i == j) + (1 - level) * LUMA[j])
                    for i in range(3) for j in range(3))


def read_level(path):
    try:
        with open(path) as f:
            for line in f:
                m = re.match(r"\s*SATURATION\s*=\s*([0-9.]+)", line)
                if m:
                    return float(m.group(1))
    except (OSError, ValueError):
        pass
    return None


def saved_level():
    for path in (user_conf(), SYSTEM_CONF):
        level = read_level(path)
        if level is not None:
            return level
    return 1.0


def save_level(level):
    path = user_conf()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("# Written by kite-vivid. 1.0 = normal colours.\nSATURATION=%s\n" % level)


def internal_outputs():
    """Connected built-in screens that have a CTM property."""
    try:
        text = subprocess.run(["xrandr", "--prop"], capture_output=True, text=True,
                              timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    found, current = [], None
    for line in text.splitlines():
        m = re.match(r"^(\S+) connected", line)
        if m:
            current = m.group(1) if INTERNAL.match(m.group(1)) else None
        elif re.match(r"^\S", line):
            current = None
        elif current and line.strip().startswith("CTM:") and current not in found:
            found.append(current)
    return found


def apply(level, quiet):
    outputs = internal_outputs()
    if not outputs:
        if not quiet:
            print("This screen does not offer a colour matrix (CTM); nothing changed.")
        return 0 if quiet else 1
    ok = True
    for o in outputs:
        r = subprocess.run(["xrandr", "--output", o, "--set", "CTM", ctm(level)],
                           capture_output=True, text=True)
        if r.returncode != 0:
            ok = False
            if not quiet:
                print("%s: %s" % (o, r.stderr.strip()), file=sys.stderr)
    if ok and not quiet:
        print("%s: saturation %.2fx" % (", ".join(outputs), level))
    return 0 if ok or quiet else 1


def main(args):
    if args[:1] == ["--print-ctm"] and len(args) == 2:      # used by the tests
        print(ctm(float(args[1])))
        return 0
    if not args:
        return apply(saved_level(), quiet=True)
    if args == ["status"]:
        outputs = internal_outputs()
        print("level: %.2fx (%s)" % (saved_level(), "supported on " + ", ".join(outputs)
                                     if outputs else "not supported on this screen"))
        return 0
    word = {"on": DEFAULT_ON, "off": 1.0}.get(args[0]) if len(args) == 1 else None
    try:
        level = word if word is not None else float(args[0]) if len(args) == 1 else None
    except ValueError:
        level = None
    if level is None or not 0.5 <= level <= 2.0:
        print(__doc__.split("\n\n")[2], file=sys.stderr)
        return 2
    save_level(level)
    return apply(level, quiet=False)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
