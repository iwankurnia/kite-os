# Resource colours (Windows 11 Task Manager's hues)
COLOURS = {"cpu": (0.0, 0.40, 0.75), "memory": (0.55, 0.22, 0.65), "swap": (0.80, 0.30, 0.55),
           "disk": (0.18, 0.55, 0.32),
           "network": (0.80, 0.40, 0.10), "battery": (0.10, 0.55, 0.55)}
HISTORY = 60


def main_ui():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk, Pango

    def heat(frac):
        """Cell shading like Windows: pale yellow, deeper with the load."""
        frac = max(0.0, min(1.0, frac))
        if frac < 0.005:
            return None
        r, g, b = 1.0, 0.96 - 0.30 * frac, 0.80 - 0.55 * frac
        return "#%02x%02x%02x" % (int(r * 255), int(g * 255), int(b * 255))

    class Graph(Gtk.DrawingArea):
        """A history graph: a line over a light fill, on a grid."""

        def __init__(self, colour, small=False):
            super().__init__()
            self.colour = colour
            self.small = small
            self.values = deque(maxlen=HISTORY)     # only real samples: the line grows in from the right
            self.scale = 100.0
            self.connect("draw", self.on_draw)

        def push(self, v, scale=100.0):
            self.values.append(v)
            self.scale = scale
            self.queue_draw()

        def on_draw(self, _w, cr):
            w, h = self.get_allocated_width(), self.get_allocated_height()
            r, g, b = self.colour
            cr.set_source_rgb(1, 1, 1)
            cr.rectangle(0, 0, w, h)
            cr.fill()
            if not self.small:
                cr.set_source_rgba(r, g, b, 0.12)
                cr.set_line_width(1)
                for i in range(1, 10):
                    x = round(w * i / 10) + 0.5
                    cr.move_to(x, 0)
                    cr.line_to(x, h)
                for i in range(1, 5):
                    y = round(h * i / 5) + 0.5
                    cr.move_to(0, y)
                    cr.line_to(w, y)
                cr.stroke()
            n = len(self.values)
            step = w / (HISTORY - 1)
            pts = [(w - (n - 1 - i) * step, h - 1 - (h - 2) * min(v / self.scale, 1.0) if self.scale else h)
                   for i, v in enumerate(self.values)]
            if n < 2:
                pts = []
            if pts:
                cr.move_to(pts[0][0], h)
                for x, y in pts:
                    cr.line_to(x, y)
                cr.line_to(w, h)
                cr.close_path()
                cr.set_source_rgba(r, g, b, 0.14)
                cr.fill()
                cr.move_to(*pts[0])
                for x, y in pts[1:]:
                    cr.line_to(x, y)
                cr.set_source_rgb(r, g, b)
                cr.set_line_width(1.2 if self.small else 1.6)
                cr.stroke()
            cr.set_source_rgba(r, g, b, 0.55)
            cr.set_line_width(1)
            cr.rectangle(0.5, 0.5, w - 1, h - 1)
            cr.stroke()
            return False

    # Tree columns
    (C_KEY, C_ICON, C_NAME, C_CPU, C_CPU_T, C_CPU_BG, C_MEM, C_MEM_T, C_MEM_BG, C_WEIGHT, C_HEADER, C_ORDER,
     C_DISK, C_DISK_T, C_DISK_BG, C_NET, C_NET_T, C_NET_BG) = range(18)
    SECTIONS = (("app", "Apps"), ("background", "Background processes"), ("system", "System processes"))

    class TaskManager(Gtk.Window):
        def __init__(self):
            super().__init__(title="Task Manager")
            self.set_default_size(980, 640)
            self.set_icon_name("utilities-system-monitor")
            self.get_style_context().add_class("kite-tasks")
            prov = Gtk.CssProvider()
            prov.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.index = AppIndex()
            # As administrator (through pkexec) the desktop user's processes
            # are still "yours": PKEXEC_UID says who asked.
            self.admin = os.geteuid() == 0
            self.uid = int(os.environ.get("PKEXEC_UID", os.getuid())) if self.admin else os.getuid()
            if self.admin:
                self.set_title("Task Manager (Administrator)")
            self.prev_ticks = {}
            self.prev_cpu = cpu_ticks()
            self.prev_proc_cpu = self.prev_cpu
            self.ncpu = cpu_info()[1]
            self.rows = {}
            self.groups = {}
            self.procs = {}
            self.filter_text = ""

            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            content.get_style_context().add_class("content")
            self.add(content)
            self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=120)

            # Toolbar, macOS style: actions on the left, the tabs as a segmented
            # control in the middle, search on the right.
            top = Gtk.Box(spacing=6)
            top.get_style_context().add_class("toolbar-row")
            self.end_btn = Gtk.Button(sensitive=False, tooltip_text="End task: quit the selected app or process")
            self.end_btn.add(Gtk.Image.new_from_icon_name("window-close-symbolic", Gtk.IconSize.BUTTON))
            self.end_btn.get_style_context().add_class("tool")
            self.end_btn.connect("clicked", self.on_end_task)
            top.pack_start(self.end_btn, False, False, 0)
            if self.admin:
                badge = Gtk.Label(label="Administrator", margin_start=6)
                badge.get_style_context().add_class("badge")
                top.pack_start(badge, False, False, 0)
            else:
                self.admin_btn = Gtk.Button(tooltip_text="Run as administrator: see and end system processes too")
                self.admin_btn.add(Gtk.Image.new_from_icon_name("security-high-symbolic", Gtk.IconSize.BUTTON))
                self.admin_btn.get_style_context().add_class("tool")
                self.admin_btn.connect("clicked", self.on_run_as_admin)
                top.pack_start(self.admin_btn, False, False, 0)
            self.tabs = Gtk.StackSwitcher(stack=self.stack, halign=Gtk.Align.CENTER)
            self.tabs.get_style_context().add_class("tabs")
            top.set_center_widget(self.tabs)
            self.search = Gtk.SearchEntry(placeholder_text="Search", width_chars=22)
            self.search.get_style_context().add_class("search")
            self.search.connect("search-changed", self.on_search)
            top.pack_end(self.search, False, False, 0)
            content.pack_start(top, False, False, 0)
            content.pack_start(self.stack, True, True, 0)

            for name, label, widget in (("processes", "Processes", self.build_processes()),
                                        ("performance", "Performance", self.build_performance()),
                                        ("startup", "Startup apps", self.build_startup())):
                self.stack.add_titled(widget, name, label)
            self.stack.connect("notify::visible-child-name", lambda *_: self.on_page())
            self.stack.set_visible_child_name("processes")

            self.tick()
            self.refresh_processes()
            GLib.timeout_add(1000, self.tick)
            GLib.timeout_add(2000, self.refresh_processes)

        def on_run_as_admin(self, _btn):
            """Start again through pkexec; come back if that is cancelled."""
            from gi.repository import Gio
            try:
                proc = Gio.Subprocess.new(["pkexec", os.path.realpath(sys.argv[0])], Gio.SubprocessFlags.NONE)
            except GLib.Error as e:
                self.set_title("Task Manager: could not start pkexec (%s)" % e.message)
                return
            self.hide()

            def done(pr, res):
                pr.wait_finish(res)
                # 126/127: password dialog cancelled or refused; else the
                # administrator window was closed, and this one is done too
                if pr.get_if_exited() and pr.get_exit_status() in (126, 127):
                    self.show()
                else:
                    self.destroy()
            proc.wait_async(None, done)

        # --------------------------------------------------------- tabs --
        def on_page(self):
            name = self.stack.get_visible_child_name()
            on_proc = name == "processes"
            # keep their space, so the tabs never move
            for w in (self.search, self.end_btn, getattr(self, "admin_btn", None)):
                if w is not None:
                    w.set_opacity(1.0 if on_proc else 0.0)
                    w.set_sensitive(on_proc and (w is not self.end_btn or bool(self.target(self.selected_key()))))
            if on_proc:
                self.on_select(None)
            if name == "startup":
                self.load_startup()

        # --------------------------------------------------- processes --
        def build_processes(self):
            self.store = Gtk.TreeStore(str, str, str, float, str, str, float, str, str, int, bool, int,
                                       float, str, str, float, str, str)
            self.filter = self.store.filter_new()
            self.filter.set_visible_func(self.visible)
            self.sorted = Gtk.TreeModelSort(model=self.filter)
            for col in (C_NAME, C_CPU, C_MEM, C_DISK, C_NET):
                self.sorted.set_sort_func(col, self.sort_func, col)
            self.sorted.set_sort_column_id(C_NAME, Gtk.SortType.ASCENDING)
            tv = Gtk.TreeView(model=self.sorted, enable_search=False, activate_on_single_click=False)
            self.tree = tv
            name_col = Gtk.TreeViewColumn("Name")
            pix = Gtk.CellRendererPixbuf(stock_size=Gtk.IconSize.LARGE_TOOLBAR, xpad=4)
            name_col.pack_start(pix, False)
            name_col.add_attribute(pix, "icon-name", C_ICON)
            txt = Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END, ypad=5)
            name_col.pack_start(txt, True)
            name_col.add_attribute(txt, "text", C_NAME)
            name_col.add_attribute(txt, "weight", C_WEIGHT)
            name_col.set_expand(True)
            name_col.set_sort_column_id(C_NAME)
            tv.append_column(name_col)
            for title, tcol, bgcol, scol, tip in (
                    ("CPU", C_CPU_T, C_CPU_BG, C_CPU, "Share of the whole processor"),
                    ("Memory", C_MEM_T, C_MEM_BG, C_MEM, "Private memory (what the app itself uses)"),
                    ("Disk", C_DISK_T, C_DISK_BG, C_DISK,
                     "Reading and writing storage. Other users' processes only as administrator"),
                    ("Network", C_NET_T, C_NET_BG, C_NET,
                     "TCP traffic. QUIC (UDP) traffic, which Brave uses for YouTube and Google, cannot be "
                     "counted per app on Linux: Performance > Wi-Fi shows all traffic")):
                r = Gtk.CellRendererText(xalign=1.0, xpad=10)
                c = Gtk.TreeViewColumn(title, r, text=tcol, cell_background=bgcol, weight=C_WEIGHT)
                c.set_min_width(100)
                c.set_alignment(1.0)
                c.set_sort_column_id(scol)
                tv.append_column(c)
                c.get_button().set_tooltip_text(tip)
            tv.get_selection().connect("changed", self.on_select)
            tv.connect("button-press-event", self.on_tree_click)
            sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, margin_start=16, margin_end=16,
                                    margin_bottom=16, margin_top=12)
            sw.get_style_context().add_class("card")
            sw.add(tv)
            self.sections = {}
            for i, (kind, label) in enumerate(SECTIONS):
                it = self.store.append(None, ["section:" + kind, None, label, 0.0, "", None, 0.0, "", None,
                                              Pango.Weight.BOLD, True, i, 0.0, "", None, 0.0, "", None])
                self.sections[kind] = (Gtk.TreeRowReference.new(self.store, self.store.get_path(it)), label)
            return sw

        def sort_func(self, model, a, b, col):
            ha, hb = model[a][C_HEADER], model[b][C_HEADER]
            if ha and hb:                       # sections keep their order
                order = model[a][C_ORDER] - model[b][C_ORDER]
                _, direction = self.sorted.get_sort_column_id()
                return order if direction == Gtk.SortType.ASCENDING else -order
            va, vb = model[a][col], model[b][col]
            if col == C_NAME:
                va, vb = (va or "").lower(), (vb or "").lower()
            return (va > vb) - (va < vb)

        def visible(self, model, it, _data):
            if not self.filter_text or model[it][C_HEADER]:
                return True
            if self.filter_text in (model[it][C_NAME] or "").lower():
                return True
            parent = model.iter_parent(it)
            if parent is not None and not model[parent][C_HEADER] and \
                    self.filter_text in (model[parent][C_NAME] or "").lower():
                return True
            child = model.iter_children(it)
            while child is not None:
                if self.filter_text in (model[child][C_NAME] or "").lower():
                    return True
                child = model.iter_next(child)
            return False

        def on_search(self, entry):
            self.filter_text = entry.get_text().strip().lower()
            self.filter.refilter()
            if self.filter_text:
                self.tree.expand_all()

        def selected_key(self):
            model, it = self.tree.get_selection().get_selected()
            return model[it][C_KEY] if it is not None else None

        def on_select(self, _sel):
            key = self.selected_key()
            g = self.target(key)
            self.end_btn.set_sensitive(bool(g and g["endable"]))

        def target(self, key):
            """The group (or the single process) a row stands for."""
            if not key or key.startswith("section:"):
                return None
            if key in self.groups:
                return self.groups[key]
            if key.startswith("pid:"):
                pid = int(key.split(":")[1])
                p = self.procs.get(pid)
                if p:
                    return {"pids": [pid], "name": program_name(p),
                            "endable": p.comm not in DESKTOP_SHELL and pid > 1 and (p.uid == self.uid or self.admin)}
            return None

        def on_tree_click(self, tv, ev):
            if ev.type == Gdk.EventType.BUTTON_PRESS and ev.button == 3:
                hit = tv.get_path_at_pos(int(ev.x), int(ev.y))
                if hit:
                    tv.get_selection().select_path(hit[0])
                    g = self.target(self.selected_key())
                    menu = Gtk.Menu()
                    item = Gtk.MenuItem(label="End task")
                    item.set_sensitive(bool(g and g["endable"]))
                    item.connect("activate", self.on_end_task)
                    menu.append(item)
                    menu.show_all()
                    menu.popup_at_pointer(ev)
                    return True
            return False

        def on_end_task(self, *_):
            g = self.target(self.selected_key())
            if not g or not g["endable"]:
                return
            starts = {}
            for pid in g["pids"]:
                p = self.procs.get(pid)
                if p:
                    starts[pid] = p.start
                    try:
                        os.kill(pid, signal.SIGTERM)
                    except OSError:
                        pass

            def force():
                # Still there after 3 s (and the same process): end it for good.
                for pid, start in starts.items():
                    p = read_proc(pid)
                    if p and p.start == start:
                        try:
                            os.kill(pid, signal.SIGKILL)
                        except OSError:
                            pass
                return False
            GLib.timeout_add(3000, force)
            GLib.timeout_add(400, self.refresh_processes)

        def refresh_processes(self):
            if not self.get_visible():
                return True
            procs = list_procs()
            busy, total = cpu_ticks()
            dt = max(total - self.prev_proc_cpu[1], 1)
            self.prev_proc_cpu = (busy, total)
            cpu = {}
            ticks = {}
            for pid, p in procs.items():
                prev = self.prev_ticks.get(pid)
                ticks[pid] = (p.ticks, p.start)
                cpu[pid] = 100.0 * (p.ticks - prev[0]) / dt if prev and prev[1] == p.start else 0.0
            self.prev_ticks = ticks
            self.procs = procs
            if self.stack.get_visible_child_name() != "processes":
                return True
            # Disk and network: per second since the last look at this page
            now = time.monotonic()
            el = max(now - getattr(self, "prev_io_t", now - 2), 0.5)
            self.prev_io_t = now
            disk, io_now = {}, {}
            for pid, p in procs.items():
                b = io_bytes(pid)
                if b is None:
                    continue
                io_now[pid] = (b, p.start)
                prev = getattr(self, "prev_io", {}).get(pid)
                disk[pid] = (b - prev[0]) / el if prev and prev[1] == p.start else 0.0
            self.prev_io = io_now
            net = getattr(self, "net_rate", {})
            self.sample_network()
            groups = group_processes(procs, self.uid, self.index, window_pids(), self.admin)
            self.groups = {g["key"]: g for g in groups}
            total_mem = meminfo().get("MemTotal", 1)
            seen = set()
            counts = {k: 0 for k, _ in SECTIONS}
            for g in groups:
                counts[g["kind"]] += 1
                gcpu = sum(cpu.get(p, 0.0) for p in g["pids"])
                gmem = sum(procs[p].mem for p in g["pids"])
                known = [disk[p] for p in g["pids"] if p in disk]
                gdisk = sum(known) if known else None
                gnet = sum(net.get(p, 0.0) for p in g["pids"])
                name = g["name"] + (" (%d)" % len(g["pids"]) if len(g["pids"]) > 1 else "")
                icon = g["icon"] or ("application-x-executable" if g["kind"] != "system" else "system-run")
                parent = self.store.get_iter(self.sections[g["kind"]][0].get_path())
                git = self.upsert(g["key"], parent, icon, name, gcpu, gmem, total_mem, gdisk, gnet)
                seen.add(g["key"])
                if len(g["pids"]) > 1:
                    for pid in g["pids"]:
                        p = procs[pid]
                        k = "pid:%d" % pid
                        self.upsert(k, git, None, display_name(p) + "  ·  %d" % pid, cpu.get(pid, 0.0), p.mem,
                                    total_mem, disk.get(pid), net.get(pid, 0.0))
                        seen.add(k)
            for k in list(self.rows):
                if k not in seen:
                    ref = self.rows.pop(k)
                    if ref.valid():
                        self.store.remove(self.store.get_iter(ref.get_path()))
            for kind, (ref, label) in self.sections.items():
                self.store[ref.get_path()][C_NAME] = "%s (%d)" % (label, counts[kind])
            if not getattr(self, "expanded", False):
                for kind in ("app", "background"):
                    path = self.sorted.convert_child_path_to_path(
                        self.filter.convert_child_path_to_path(self.sections[kind][0].get_path()))
                    if path:
                        self.tree.expand_row(path, False)
                self.expanded = True
            self.on_select(None)
            return True

        def sample_network(self):
            """Run ss in the background (55-130 ms on the N4020); its result
            gives the Network column at the next refresh."""
            from gi.repository import Gio
            if getattr(self, "ss_running", False):
                return
            try:
                proc = Gio.Subprocess.new(["ss", "-tinpH", "state", "established"],
                                          Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
            except GLib.Error:
                return
            self.ss_running = True

            def done(pr, res):
                self.ss_running = False
                try:
                    _ok, out, _err = pr.communicate_utf8_finish(res)
                except GLib.Error:
                    return
                now = time.monotonic()
                el = max(now - getattr(self, "prev_ss_t", now - 2), 0.5)
                self.prev_ss_t = now
                socks = parse_ss(out or "")
                rate = {}
                for key, (pid, sent, recv) in socks.items():
                    prev = getattr(self, "prev_socks", {}).get(key)
                    if prev and prev[0] == pid:
                        rate[pid] = rate.get(pid, 0.0) + max(0, sent - prev[1] + recv - prev[2]) / el
                self.prev_socks = socks
                self.net_rate = rate
            proc.communicate_utf8_async(None, None, done)

        def upsert(self, key, parent, icon, name, cpu, mem, total_mem, disk=None, net=0.0):
            vals = {C_ICON: icon, C_NAME: name, C_CPU: cpu, C_CPU_T: "%.1f%%" % cpu,
                    C_CPU_BG: heat(cpu / 100.0), C_MEM: float(mem), C_MEM_T: fmt_bytes(mem),
                    C_MEM_BG: heat(mem / total_mem * 4),
                    C_DISK: disk if disk is not None else -1.0,
                    C_DISK_T: "—" if disk is None else ("0 MB/s" if disk < 50e3 else "%.1f MB/s" % (disk / 1e6)),
                    C_DISK_BG: heat(disk / 10e6) if disk else None,
                    C_NET: net, C_NET_T: "0 Mbps" if net < 1250 else "%.1f Mbps" % (net * 8 / 1e6),
                    C_NET_BG: heat(net / 2e6) if net else None}
            ref = self.rows.get(key)
            if ref and ref.valid():
                it = self.store.get_iter(ref.get_path())
                cur = self.store.iter_parent(it)
                if cur is not None and self.store.get_path(cur) == self.store.get_path(parent):
                    for col, v in vals.items():
                        if self.store[it][col] != v:
                            self.store.set_value(it, col, v)
                    return it
                self.store.remove(it)
            it = self.store.append(parent, [key, icon, name, cpu, vals[C_CPU_T], vals[C_CPU_BG], float(mem),
                                            vals[C_MEM_T], vals[C_MEM_BG], Pango.Weight.NORMAL, False, 0,
                                            vals[C_DISK], vals[C_DISK_T], vals[C_DISK_BG], net,
                                            vals[C_NET_T], vals[C_NET_BG]])
            self.rows[key] = Gtk.TreeRowReference.new(self.store, self.store.get_path(it))
            return it

        # ------------------------------------------------- performance --
        def build_performance(self):
            box = Gtk.Box(spacing=0, margin_start=8, margin_end=16, margin_bottom=16, margin_top=12)
            self.tiles = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE, width_request=230)
            self.tiles.get_style_context().add_class("tiles")
            box.pack_start(self.tiles, False, False, 0)
            self.detail = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=120)
            card = Gtk.Box()
            card.get_style_context().add_class("card")
            card.pack_start(self.detail, True, True, 0)
            box.pack_start(card, True, True, 0)

            model, self.ncpu = cpu_info()
            self.disk = root_disk()
            self.iface = net_iface()
            self.prev_disk = disk_stats(self.disk) if self.disk else None
            self.prev_net = net_bytes(self.iface) if self.iface else None
            self.prev_t = time.monotonic()
            self.res = {}
            mx = cpu_speed_ghz()[1]
            subtitle = {"cpu": model, "memory": fmt_bytes(meminfo().get("MemTotal", 0)) + " RAM",
                        "disk": "%s (system disk)" % self.disk if self.disk else "",
                        "network": self.iface or "", "battery": ""}
            names = [("cpu", "CPU"), ("memory", "Memory")]
            if self.disk:
                names.append(("disk", "Disk"))
            if self.iface:
                names.append(("network", "Wi-Fi" if self.iface.startswith("wl") else "Ethernet"))
            if battery():
                names.append(("battery", "Battery"))
            for key, label in names:
                colour = COLOURS[key]
                row = Gtk.ListBoxRow()
                h = Gtk.Box(spacing=10)
                spark = Graph(colour, small=True)
                spark.set_size_request(64, 40)
                h.pack_start(spark, False, False, 0)
                v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
                n = Gtk.Label(label=label, xalign=0)
                n.get_style_context().add_class("tile-name")
                # a fixed width: changing text must not resize the list (that
                # moved the edge of the graph card every second)
                val = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, width_chars=22, max_width_chars=22)
                val.get_style_context().add_class("tile-value")
                v.pack_start(n, False, False, 0)
                v.pack_start(val, False, False, 0)
                h.pack_start(v, True, True, 0)
                row.add(h)
                row.key = key
                self.tiles.add(row)
                # detail page
                page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=18)
                head = Gtk.Box()
                t = Gtk.Label(xalign=0)
                t.set_markup("<span size='x-large' weight='600'>%s</span>" % GLib.markup_escape_text(label))
                head.pack_start(t, False, False, 0)
                st = Gtk.Label(label=mx and key == "cpu" and "%s   (up to %.2f GHz)" % (subtitle[key], mx)
                               or subtitle[key], xalign=1, ellipsize=Pango.EllipsizeMode.END)
                st.get_style_context().add_class("subtitle")
                head.pack_end(st, True, True, 0)
                page.pack_start(head, False, False, 0)
                cap = Gtk.Box()
                left = Gtk.Label(xalign=0)
                left.get_style_context().add_class("stat-label")
                right = Gtk.Label(xalign=1)
                right.get_style_context().add_class("stat-label")
                cap.pack_start(left, True, True, 0)
                cap.pack_end(right, False, False, 0)
                page.pack_start(cap, False, False, 0)
                graph = Graph(colour)
                graph.set_size_request(-1, 200 if key == "memory" else 260)
                page.pack_start(graph, True, True, 0)
                swap = None
                if key == "memory":
                    scap = Gtk.Box(margin_top=6)
                    sl = Gtk.Label(label="Swap in use (also holds the hibernation image)", xalign=0)
                    sl.get_style_context().add_class("stat-label")
                    sr = Gtk.Label(xalign=1)
                    sr.get_style_context().add_class("stat-label")
                    scap.pack_start(sl, True, True, 0)
                    scap.pack_end(sr, False, False, 0)
                    page.pack_start(scap, False, False, 0)
                    swap = Graph(COLOURS["swap"])
                    swap.set_size_request(-1, 70)
                    page.pack_start(swap, False, False, 0)
                foot = Gtk.Box()
                fl = Gtk.Label(label="60 seconds", xalign=0)
                fl.get_style_context().add_class("stat-label")
                fr = Gtk.Label(label="0", xalign=1)
                fr.get_style_context().add_class("stat-label")
                foot.pack_start(fl, True, True, 0)
                foot.pack_end(fr, False, False, 0)
                page.pack_start(foot, False, False, 0)
                grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=4,
                                   min_children_per_line=2, column_spacing=28, row_spacing=12, margin_top=10)
                page.pack_start(grid, False, False, 0)
                self.detail.add_named(page, key)
                self.res[key] = {"spark": spark, "value": val, "graph": graph, "grid": grid, "stats": {},
                                 "cap_left": left, "cap_right": right, "swap": swap,
                                 "swap_cap": sr if swap else None}
            self.tiles.connect("row-selected", lambda _l, r: r and self.detail.set_visible_child_name(r.key))
            self.tiles.select_row(self.tiles.get_row_at_index(0))
            return box

        def stats(self, key, pairs):
            """Show (label, value) pairs under the graph, updating in place."""
            r = self.res[key]
            for label, value in pairs:
                lab = r["stats"].get(label)
                if lab is None:
                    b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                    l1 = Gtk.Label(label=label, xalign=0)
                    l1.get_style_context().add_class("stat-label")
                    lab = Gtk.Label(xalign=0, width_chars=16, max_width_chars=16,
                                    ellipsize=Pango.EllipsizeMode.END)
                    lab.get_style_context().add_class("stat-value")
                    b.pack_start(l1, False, False, 0)
                    b.pack_start(lab, False, False, 0)
                    b.show_all()
                    r["grid"].add(b)
                    r["stats"][label] = lab
                lab.set_text(value)

        def tick(self):
            now = time.monotonic()
            dt = max(now - self.prev_t, 0.001)
            self.prev_t = now
            busy, total = cpu_ticks()
            pb, pt = self.prev_cpu
            cpu = 100.0 * (busy - pb) / max(total - pt, 1)
            self.prev_cpu = (busy, total)
            cur, _mx = cpu_speed_ghz()
            nproc, nthreads = task_counts()
            r = self.res["cpu"]
            r["graph"].push(cpu)
            r["spark"].push(cpu)
            r["value"].set_text("%.0f%%" % cpu + ("  %.2f GHz" % cur if cur else ""))
            r["cap_left"].set_text("% Utilisation over 60 seconds")
            r["cap_right"].set_text("100%")
            self.stats("cpu", [("Utilisation", "%.0f%%" % cpu), ("Speed", "%.2f GHz" % cur if cur else "—"),
                               ("Processes", str(nproc)), ("Threads", str(nthreads)),
                               ("Cores", str(self.ncpu)), ("Up time", fmt_uptime(uptime_s()))])

            m = meminfo()
            tot = m.get("MemTotal", 1)
            used = tot - m.get("MemAvailable", 0)
            r = self.res["memory"]
            r["graph"].push(100.0 * used / tot)
            r["spark"].push(100.0 * used / tot)
            r["value"].set_text("%s / %s (%.0f%%)" % (fmt_bytes(used), fmt_bytes(tot), 100.0 * used / tot))
            r["cap_left"].set_text("Memory in use")
            r["cap_right"].set_text(fmt_bytes(tot))
            swap_used = m.get("SwapTotal", 0) - m.get("SwapFree", 0)
            if r["swap"] is not None:
                r["swap"].push(100.0 * swap_used / m["SwapTotal"] if m.get("SwapTotal") else 0.0)
                r["swap_cap"].set_text(fmt_bytes(m.get("SwapTotal", 0)))
            zs, zd = m.get("Zswapped", 0), m.get("Zswap", 0)
            self.stats("memory", [("In use", fmt_bytes(used)), ("Available", fmt_bytes(m.get("MemAvailable", 0))),
                                  ("Cached", fmt_bytes(m.get("Cached", 0))),
                                  ("Swap (for hibernation)", "%s of %s" % (fmt_bytes(swap_used), fmt_bytes(m.get("SwapTotal", 0)))),
                                  ("Compressed in RAM (zswap)", "%s in %s" % (fmt_bytes(zs), fmt_bytes(zd)) if zs else "nothing")])

            if self.disk and "disk" in self.res:
                d = disk_stats(self.disk)
                r = self.res["disk"]
                if d and self.prev_disk:
                    rd = (d[0] - self.prev_disk[0]) * 512 / dt
                    wr = (d[1] - self.prev_disk[1]) * 512 / dt
                    act = min(100.0, (d[2] - self.prev_disk[2]) / (dt * 10))
                    r["graph"].push(act)
                    r["spark"].push(act)
                    r["value"].set_text("%.0f%% active" % act)
                    r["cap_left"].set_text("Active time")
                    r["cap_right"].set_text("100%")
                    try:
                        st = os.statvfs("/")
                        cap, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
                    except OSError:
                        cap = free = 0
                    self.stats("disk", [("Active time", "%.0f%%" % act), ("Read", fmt_bytes(rd, True)),
                                        ("Write", fmt_bytes(wr, True)), ("Used", "%s of %s" % (fmt_bytes(cap - free), fmt_bytes(cap))),
                                        ("Free", fmt_bytes(free))])
                self.prev_disk = d

            if self.iface and "network" in self.res:
                n = net_bytes(self.iface)
                r = self.res["network"]
                if n and self.prev_net:
                    rx = (n[0] - self.prev_net[0]) / dt
                    tx = (n[1] - self.prev_net[1]) / dt
                    tput = (rx + tx) * 8
                    peak = max(max(r["graph"].values, default=0), tput, 100e3)
                    scale = 10 ** len(str(int(peak))) / 10
                    while scale < peak:
                        scale *= 2
                    r["graph"].push(tput, scale)
                    r["spark"].push(tput, scale)
                    r["value"].set_text("↓ %s  ↑ %s" % (fmt_bytes(rx, True), fmt_bytes(tx, True)))
                    r["cap_left"].set_text("Throughput")
                    r["cap_right"].set_text("%s/s" % ("%.0f Mbit" % (scale / 1e6) if scale >= 1e6 else "%.0f kbit" % (scale / 1e3)))
                    self.stats("network", [("Receive", fmt_bytes(rx, True)), ("Send", fmt_bytes(tx, True)),
                                           ("Adapter", self.iface)])
                self.prev_net = n

            if "battery" in self.res:
                b = battery()
                if b:
                    r = self.res["battery"]
                    r["graph"].push(b["capacity"])
                    r["spark"].push(b["capacity"])
                    r["value"].set_text("%d%%  %s" % (b["capacity"], b["status"]))
                    r["cap_left"].set_text("Charge")
                    r["cap_right"].set_text("100%")
                    self.stats("battery", [("Charge", "%d%%" % b["capacity"]), ("Status", b["status"])])
            return True

        # ------------------------------------------------------ startup --
        def build_startup(self):
            sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, margin_start=16, margin_end=16,
                                    margin_bottom=16, margin_top=12)
            sw.get_style_context().add_class("card")
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            note = Gtk.Label(label="Apps that start when you log in. Fewer leaves more memory for your work."
                             + ("  (Open Task Manager without administrator rights to change these: they are"
                                " your own settings.)" if os.geteuid() == 0 else ""),
                             xalign=0, margin=12, wrap=True)
            note.get_style_context().add_class("subtitle")
            v.pack_start(note, False, False, 0)
            self.startup = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            self.startup.get_style_context().add_class("startup")
            v.pack_start(self.startup, False, False, 0)
            sw.add(v)
            return sw

        def load_startup(self):
            for child in self.startup.get_children():
                self.startup.remove(child)
            for e in startup_entries():
                row = Gtk.ListBoxRow(activatable=False)
                h = Gtk.Box(spacing=12)
                h.pack_start(Gtk.Image.new_from_icon_name(e["icon"], Gtk.IconSize.DND), False, False, 0)
                t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
                t.pack_start(Gtk.Label(label=e["name"], xalign=0), False, False, 0)
                if e["comment"]:
                    c = Gtk.Label(label=e["comment"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
                    c.get_style_context().add_class("subtitle")
                    t.pack_start(c, False, False, 0)
                h.pack_start(t, True, True, 0)
                sw = Gtk.Switch(active=e["enabled"], valign=Gtk.Align.CENTER,
                                sensitive=not self.admin and not e["essential"])
                if e["essential"]:
                    sw.set_tooltip_text("KiteOS needs this (settings, password prompts, the lock screen or the lid)")
                sw.connect("notify::active", lambda s, _p, f=e["file"]: set_startup(f, s.get_active()))
                h.pack_end(sw, False, False, 0)
                row.add(h)
                self.startup.add(row)
            self.startup.show_all()

    return TaskManager


def main(argv):
    if argv[:1] == ["--dump"]:
        dump()
        return 0
    if argv:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    TaskManager = main_ui()
    from gi.repository import Gtk
    win = TaskManager()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.on_page()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
