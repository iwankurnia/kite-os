#!/usr/bin/python3
"""KiteOS Task Manager: apps and processes, performance, startup apps.

  kite-tasks                  open it (Ctrl+Shift+Esc)
  kite-tasks --dump           print the app groups once, for tests and bug reports

Processes are grouped the way Windows does it: an app with everything it
started (Brave's or VS Code's many processes are one row), found by walking
up each process's parents until a desktop process (the panel, the session,
the settings daemon) that launched it. A group is an app when one of its
processes has a window; the rest are background processes. Memory is each
process's private memory (RssAnon, like Windows' "private working set": a
shared library is not counted again for every process), readable for every
process without root. CPU is the share of the whole machine, as on Windows.

"Run as administrator" starts it again through pkexec (polkit action
org.kiteos.tasks): then it can end other users' and system processes too.

The data code below needs no GTK or display (the tests use a fake /proc via
KITE_PROC and KITE_SYS); the window is built only when it runs.
"""
import configparser
import glob
import os
import re
import signal
import subprocess
import sys
import time
from collections import deque

PROC = os.environ.get("KITE_PROC", "/proc")
SYS = os.environ.get("KITE_SYS", "/sys")
APP_DIRS = [d for d in os.environ.get("KITE_APP_DIRS", "").split(":") if d] or [
    os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "applications"),
    "/usr/local/share/applications", "/usr/share/applications"]
AUTOSTART_SYSTEM = os.environ.get("KITE_AUTOSTART_SYSTEM", "/etc/xdg/autostart")
AUTOSTART_USER = os.environ.get("KITE_AUTOSTART_USER") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "autostart")

# Desktop processes: they launch apps, so a walk up the parents stops at them;
# ending them would break the session, so they cannot be ended here.
DESKTOP_SHELL = {"systemd", "(sd-pam)", "xfce4-session", "xfce4-panel", "wrapper-2.0", "xfsettingsd",
                 "xfdesktop", "xfwm4", "xfconfd", "lightdm", "Xorg", "X", "dbus-daemon", "dbus-broker",
                 "at-spi-bus-laun", "at-spi2-registr", "gnome-keyring-d", "Xsession", "startxfce4"}
INTERPRETERS = ("python", "perl", "ruby", "node", "sh", "bash", "dash")
# Startup entries KiteOS needs: settings and keyboard shortcuts, password
# prompts, the lock screen, lid and battery handling. Shown, not switchable.
ESSENTIAL_STARTUP = {"xfsettingsd.desktop", "polkit-mate-authentication-agent-1.desktop",
                     "xfce4-screensaver.desktop", "xfce4-power-manager.desktop"}


def read(path, default=""):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return default


# ------------------------------------------------------------- the machine --
def meminfo():
    """/proc/meminfo in bytes."""
    out = {}
    for line in read(os.path.join(PROC, "meminfo")).splitlines():
        k, _, v = line.partition(":")
        parts = v.split()
        if parts and parts[0].isdigit():
            out[k] = int(parts[0]) * (1024 if len(parts) > 1 else 1)
    return out


def cpu_ticks():
    """(busy, total) clock ticks of all CPUs together, from /proc/stat."""
    for line in read(os.path.join(PROC, "stat")).splitlines():
        if line.startswith("cpu "):
            v = [int(x) for x in line.split()[1:]]
            idle = v[3] + (v[4] if len(v) > 4 else 0)            # idle + iowait
            total = sum(v[:8])                                    # without guest time
            return total - idle, total
    return 0, 0


def cpu_info():
    model, cores = "", 0
    for line in read(os.path.join(PROC, "cpuinfo")).splitlines():
        if line.startswith("model name") and not model:
            model = line.split(":", 1)[1].strip()
        if line.startswith("processor"):
            cores += 1
    return model, max(cores, 1)


def cpu_speed_ghz():
    """Mean current frequency, and the maximum, in GHz (None if unknown)."""
    cur = [int(read(f, "0") or 0) for f in glob.glob(os.path.join(SYS, "devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq"))]
    mx = read(os.path.join(SYS, "devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq")).strip()
    cur = [c for c in cur if c > 0]
    return (sum(cur) / len(cur) / 1e6 if cur else None), (int(mx) / 1e6 if mx.isdigit() else None)


def task_counts():
    """(processes, threads) on the system."""
    la = read(os.path.join(PROC, "loadavg")).split()
    threads = int(la[3].split("/")[1]) if len(la) > 3 and "/" in la[3] else 0
    procs = sum(1 for d in os.listdir(PROC) if d.isdigit()) if os.path.isdir(PROC) else 0
    return procs, threads


def uptime_s():
    v = read(os.path.join(PROC, "uptime")).split()
    return float(v[0]) if v else 0.0


def root_disk():
    """(device name, e.g. mmcblk0) of the disk that holds /."""
    for line in read(os.path.join(PROC, "self/mounts")).splitlines():
        f = line.split()
        if len(f) > 1 and f[1] == "/" and f[0].startswith("/dev/"):
            dev = os.path.basename(os.path.realpath(f[0]))
            parent = os.path.join(SYS, "class/block", dev, "..")
            if os.path.isfile(os.path.join(SYS, "class/block", dev, "partition")):
                return os.path.basename(os.path.realpath(parent))
            return dev
    return None


def disk_stats(dev):
    """(sectors read, sectors written, ms busy) for DEV from /proc/diskstats."""
    for line in read(os.path.join(PROC, "diskstats")).splitlines():
        f = line.split()
        if len(f) > 12 and f[2] == dev:
            return int(f[5]), int(f[9]), int(f[12])
    return None


def net_iface():
    """The wireless interface, else the first non-loopback one."""
    names = []
    for line in read(os.path.join(PROC, "net/dev")).splitlines()[2:]:
        name = line.split(":", 1)[0].strip()
        if name and name != "lo":
            names.append(name)
    for n in names:
        if os.path.isdir(os.path.join(SYS, "class/net", n, "wireless")) or n.startswith("wl"):
            return n
    return names[0] if names else None


def net_bytes(iface):
    """(received, sent) bytes on IFACE."""
    for line in read(os.path.join(PROC, "net/dev")).splitlines()[2:]:
        name, _, rest = line.partition(":")
        if name.strip() == iface:
            f = rest.split()
            return int(f[0]), int(f[8])
    return None


def io_bytes(pid):
    """Bytes a process has read from and written to storage, or None when the
    kernel does not let us see it (another user's process)."""
    r = w = None
    for line in read(os.path.join(PROC, str(pid), "io")).splitlines():
        if line.startswith("read_bytes:"):
            r = int(line.split()[1])
        elif line.startswith("write_bytes:"):
            w = int(line.split()[1])
    return r + w if r is not None and w is not None else None


def parse_ss(text):
    """`ss -tinpH state established` -> {(local, peer): (pid, sent, received)}.
    Linux keeps byte counts per TCP connection only: UDP (QUIC, which Brave
    uses for YouTube and Google) has none, so it is not counted per app."""
    out, cur, pid = {}, None, None
    for line in text.splitlines():
        if not line.strip():
            continue
        if not line[0].isspace():
            f = line.split()
            m = re.search(r"pid=(\d+)", line)
            cur = (f[2], f[3]) if len(f) >= 4 and m else None
            pid = int(m.group(1)) if m else None
        elif cur:
            s = re.search(r"bytes_sent:(\d+)", line)
            r = re.search(r"bytes_received:(\d+)", line)
            out[cur] = (pid, int(s.group(1)) if s else 0, int(r.group(1)) if r else 0)
            cur = None
    return out


def battery():
    """{'capacity': %, 'status': text} of the first battery, or None."""
    for b in sorted(glob.glob(os.path.join(SYS, "class/power_supply/BAT*"))):
        cap = read(os.path.join(b, "capacity")).strip()
        if cap.isdigit():
            return {"capacity": int(cap), "status": read(os.path.join(b, "status")).strip() or "Unknown"}
    return None


# --------------------------------------------------------------- processes --
class Proc:
    __slots__ = ("pid", "ppid", "uid", "comm", "exe", "argv", "ticks", "start", "mem", "threads")


def read_proc(pid):
    base = os.path.join(PROC, str(pid))
    stat = read(os.path.join(base, "stat"))
    if not stat:
        return None
    p = Proc()
    p.pid = pid
    lp, rp = stat.find("("), stat.rfind(")")
    p.comm = stat[lp + 1:rp]
    f = stat[rp + 2:].split()
    p.ppid = int(f[1])
    p.ticks = int(f[11]) + int(f[12])          # utime + stime
    p.threads = int(f[17])
    p.start = int(f[19])
    p.uid = None
    p.mem = 0
    for line in read(os.path.join(base, "status")).splitlines():
        if line.startswith("Uid:"):
            p.uid = int(line.split()[1])
        elif line.startswith("RssAnon:"):
            p.mem = int(line.split()[1]) * 1024
    p.argv = [a for a in read(os.path.join(base, "cmdline")).split("\0") if a]
    try:
        p.exe = os.readlink(os.path.join(base, "exe"))
    except OSError:
        p.exe = ""
    return p


def list_procs():
    out = {}
    try:
        names = os.listdir(PROC)
    except OSError:
        return out
    for d in names:
        if d.isdigit():
            p = read_proc(int(d))
            if p and p.ppid != 2 and p.pid != 2:            # no kernel threads
                out[p.pid] = p
    return out


def program_name(p):
    """What the process runs: the script for an interpreter, else the program."""
    exe = os.path.basename(p.exe.replace(" (deleted)", "")) if p.exe else ""
    if exe.startswith(INTERPRETERS) and len(p.argv) > 1:
        for a in p.argv[1:]:
            if not a.startswith("-"):
                return os.path.basename(a)
    return exe or (os.path.basename(p.argv[0]) if p.argv else "") or p.comm


def display_name(p):
    """A name for a process row: panel plugins by their own name."""
    if p.comm == "wrapper-2.0" and len(p.argv) > 5:
        return "Panel: " + p.argv[5]
    return program_name(p)


def bare(name):
    """A program name without launcher suffixes (brave-browser-stable.distrib)."""
    name = name.lower()
    for suffix in (".distrib", ".real", ".bin", ".sh", ".py", ".wrapper"):
        if name.endswith(suffix):
            name = name[:-len(suffix)]
    return name


# ------------------------------------------------------------- app index --
def desktop_entry(path):
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    try:
        cp.read(path, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError):
        return None
    if not cp.has_section("Desktop Entry"):
        return None
    return dict(cp.items("Desktop Entry"))


class AppIndex:
    """Matches a program to its .desktop file (name and icon)."""

    def __init__(self, dirs=None):
        self.by_key = {}
        self.ids = []
        ids = {}
        seen = set()
        for d in dirs or APP_DIRS:
            for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
                did = os.path.basename(path)[:-8]
                if did in seen:
                    continue
                seen.add(did)
                e = desktop_entry(path)
                if not e or e.get("Type") != "Application" or e.get("NoDisplay") == "true" or not e.get("Name"):
                    continue
                app = {"id": did, "name": e["Name"], "icon": e.get("Icon") or "application-x-executable"}
                self.ids.append((did.lower(), app))
                keys = {(e.get("StartupWMClass") or "").lower()}
                exe = (e.get("Exec") or "").split()
                if exe:
                    keys.add(os.path.basename(exe[0]).lower())
                    if exe[0].startswith("/") and os.path.exists(exe[0]):
                        keys.add(os.path.basename(os.path.realpath(exe[0])).lower())
                for k in keys - {""}:
                    self.by_key.setdefault(k, app)
                ids[did.lower()] = app
        # A desktop file named after the program beats one that only runs it
        # (thunar.desktop, not thunar-bulk-rename.desktop, for "thunar").
        self.by_key.update(ids)

    def find(self, prog, comm):
        keys = (bare(prog), comm.lower())
        for k in keys:
            if k in self.by_key:
                return self.by_key[k]
        # "desktopeditors" in onlyoffice-desktopeditors; brave-browser-stable
        # starts with brave-browser
        for k in keys:
            if len(k) >= 4:
                for did, app in self.ids:
                    stem = did.split(".")[-1]
                    if k in stem or (len(stem) >= 5 and k.startswith(stem)):
                        return app
        return None


def group_processes(procs, uid, index, window_pids=None, admin=False):
    """Group processes into apps. Returns a list of dicts:
    key, kind ('app', 'background' or 'system'), name, icon, pids, endable.
    WINDOW_PIDS: processes that have a window (None: not known, then a
    matching .desktop file makes an app). ADMIN: any process but the desktop's
    own and init can be ended."""
    root_of = {}

    def root(pid):
        chain = []
        while pid in procs and pid not in root_of:
            p = procs[pid]
            parent = procs.get(p.ppid)
            chain.append(pid)
            if (p.comm in DESKTOP_SHELL or parent is None or parent.comm in DESKTOP_SHELL
                    or parent.uid != p.uid or parent.pid <= 1):
                root_of[pid] = pid
                break
            pid = p.ppid
        r = root_of.get(pid, pid)
        for c in chain:
            root_of[c] = r
        return r

    groups = {}
    for pid in procs:
        r = root(pid)
        groups.setdefault(r, []).append(pid)
    out = []
    for r, pids in groups.items():
        p = procs[r]
        prog = program_name(p)
        mine = p.uid == uid
        shell = p.comm in DESKTOP_SHELL
        app = index.find(prog, p.comm) if mine and not shell else None
        if window_pids is None:
            is_app = bool(app)
        else:
            is_app = mine and not shell and bool(window_pids.intersection(pids))
        out.append({
            "key": "%d:%d" % (r, p.start),
            "kind": "app" if is_app else ("background" if mine else "system"),
            "name": app["name"] if app else display_name(p),
            "icon": app["icon"] if app else None,
            "pids": sorted(pids),
            "endable": not shell and r > 1 and (mine or admin),
        })
    return out


def window_pids():
    """PIDs that own a top-level window (_NET_CLIENT_LIST + _NET_WM_PID), from
    libX11 directly; None without an X display."""
    import ctypes
    import ctypes.util
    lib = ctypes.util.find_library("X11")
    if not lib or not os.environ.get("DISPLAY"):
        return None
    x = ctypes.CDLL(lib)
    x.XOpenDisplay.restype = ctypes.c_void_p
    x.XDefaultRootWindow.restype = ctypes.c_ulong
    x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    x.XInternAtom.restype = ctypes.c_ulong
    x.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
    x.XGetWindowProperty.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_long, ctypes.c_long,
                                     ctypes.c_int, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong),
                                     ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_ulong),
                                     ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_void_p)]
    x.XFree.argtypes = [ctypes.c_void_p]
    x.XCloseDisplay.argtypes = [ctypes.c_void_p]
    d = x.XOpenDisplay(None)
    if not d:
        return None

    def prop(win, name):
        atype, afmt = ctypes.c_ulong(), ctypes.c_int()
        n, after, data = ctypes.c_ulong(), ctypes.c_ulong(), ctypes.c_void_p()
        if x.XGetWindowProperty(d, win, x.XInternAtom(d, name, 0), 0, 65536, 0, 0, ctypes.byref(atype),
                                ctypes.byref(afmt), ctypes.byref(n), ctypes.byref(after), ctypes.byref(data)) != 0:
            return []
        if not data.value:
            return []
        vals = list(ctypes.cast(data, ctypes.POINTER(ctypes.c_ulong))[:n.value]) if afmt.value == 32 else []
        x.XFree(data)
        return vals

    try:
        out = set()
        for win in prop(x.XDefaultRootWindow(d), b"_NET_CLIENT_LIST"):
            out.update(prop(win, b"_NET_WM_PID"))
        return out
    finally:
        x.XCloseDisplay(d)


# ------------------------------------------------------------ startup apps --
def startup_entries():
    """Autostart entries for XFCE: [{file, name, comment, icon, enabled}]."""
    files = {}
    for d in (AUTOSTART_SYSTEM, AUTOSTART_USER):
        for path in glob.glob(os.path.join(d, "*.desktop")):
            files[os.path.basename(path)] = path            # the user's copy wins
    out = []
    for name, path in sorted(files.items()):
        e = desktop_entry(path)
        sysfile = os.path.join(AUTOSTART_SYSTEM, name)
        base = desktop_entry(sysfile) if path != sysfile and os.path.exists(sysfile) else None
        if not e:
            continue
        info = dict(base or {}, **e)
        only = info.get("OnlyShowIn", "")
        if (only and "XFCE" not in only.split(";")) or "XFCE" in info.get("NotShowIn", "").split(";"):
            continue
        if not info.get("Name"):
            continue
        enabled = e.get("Hidden", "false") != "true" and info.get("X-GNOME-Autostart-enabled", "true") != "false"
        out.append({"file": name, "name": info["Name"], "comment": info.get("Comment", ""),
                    "icon": info.get("Icon") or "application-x-executable", "enabled": enabled,
                    "essential": name in ESSENTIAL_STARTUP})
    return out


def set_startup(file, enabled):
    """Switch an autostart entry on or off for this user (a copy in
    ~/.config/autostart with Hidden=, as XFCE's own Session settings do)."""
    os.makedirs(AUTOSTART_USER, exist_ok=True)
    user = os.path.join(AUTOSTART_USER, file)
    src = user if os.path.exists(user) else os.path.join(AUTOSTART_SYSTEM, file)
    lines = read(src).splitlines()
    out, in_entry, done = [], False, False
    for line in lines:
        if line.startswith("["):
            if in_entry and not done:
                out.append("Hidden=%s" % ("false" if enabled else "true"))
                done = True
            in_entry = line.strip() == "[Desktop Entry]"
        if in_entry and line.startswith("Hidden="):
            if not done:
                out.append("Hidden=%s" % ("false" if enabled else "true"))
                done = True
            continue
        out.append(line)
    if not done:
        out.append("Hidden=%s" % ("false" if enabled else "true"))
    tmp = user + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")
    os.replace(tmp, user)


# ----------------------------------------------------------------- format --
def fmt_bytes(n, rate=False):
    units = ("B", "KB", "MB", "GB", "TB")
    v = float(n)
    i = 0
    while v >= 1000 and i < len(units) - 1:
        v /= 1024
        i += 1
    s = ("%.0f" if v >= 100 or i == 0 else "%.1f") % v
    return "%s %s%s" % (s, units[i], "/s" if rate else "")


def fmt_uptime(s):
    s = int(s)
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    return ("%d:" % d if d else "") + "%02d:%02d:%02d" % (h, m, s)


def dump():
    procs = list_procs()
    groups = group_processes(procs, os.getuid(), AppIndex(), window_pids())
    for g in sorted(groups, key=lambda g: ("app", "background", "system").index(g["kind"])):
        mem = sum(procs[p].mem for p in g["pids"])
        print("%-10s %-32s %3d proc %9s" % (g["kind"], g["name"][:32], len(g["pids"]), fmt_bytes(mem)))


