#!/usr/bin/python3
"""Settings > Battery: the power mode, Battery saver or Best performance.
It follows the charger (Battery saver on battery, Best performance plugged
in); the two-stop slider, like the battery pop-up's, chooses the other one
until the charger is plugged in or unplugged, or the laptop restarts
(kite-power saver / full
through pkexec; polkit action org.kiteos.power lets the person at the laptop
do it without a password).
"""
import os
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

STATE = os.environ.get("KITE_POWER_STATE", "/run/kite/power")
CHOSEN = [os.path.join(os.path.dirname(STATE), n) for n in ("power-full", "power-saver")]
BOOST = os.environ.get("KITE_TLP_BOOST", "/etc/tlp.d/61-kite-boost.conf")
KP = "/usr/sbin/kite-power"

# (title, line under it when the mode follows the charger, when it was chosen)
TEXT = {
    "ac": ("Best performance", "Plugged in. Battery saver comes on when you unplug.", ""),
    "saving": ("Battery saver", "On battery. Everything below is in force.",
               "Chosen: until you plug in or unplug the charger, or restart. Everything below is in force."),
    "full": ("Best performance", "", "Chosen: until you plug in or unplug the charger, or restart."),
}
SAVER, PERFORMANCE = 0, 1
CPU_SAVING = "The processor stays at its base speed (no turbo) and prefers to save energy."
CPU_LOW_END = ("The processor keeps its boost, as a low-end processor needs it for the web, "
               "and leans towards saving energy.")
SAVING = [
    None,                       # CPU_SAVING or CPU_LOW_END, see cpu_line()
    "On laptops with performance and efficiency cores, system services run on the efficiency cores.",
    "The graphics chip's top speed is lowered; video still plays smoothly.",
    "Wi-Fi, PCI Express links and idle devices (webcam, card reader, USB) sleep when not in use.",
    "Bluetooth is switched off when you unplug, if nothing is connected.",
    "Brave's energy saver runs: background tabs and video frame rates are throttled.",
    "The screen dims and the laptop sleeps sooner when idle (Power Manager settings).",
]


def cpu_line():
    """kite-power writes TLP's boost drop-in on low-end CPUs (the N4020)."""
    return CPU_LOW_END if os.path.exists(BOOST) else CPU_SAVING


def mode():
    try:
        with open(STATE) as f:
            m = f.read().strip()
        return m if m in TEXT else "ac"
    except OSError:
        return "ac"


class Window(Gtk.Window):
    def __init__(self):
        super().__init__(title="Battery")
        self.set_icon_name("battery")
        self.set_default_size(520, -1)
        self.set_resizable(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=16)
        self.add(box)
        self.title = Gtk.Label(xalign=0)
        self.sub = Gtk.Label(xalign=0, wrap=True)
        self.sub.get_style_context().add_class("dim-label")
        box.pack_start(self.title, False, False, 0)
        box.pack_start(self.sub, False, False, 0)
        # Power mode: a two-stop slider, as in the battery pop-up
        row = Gtk.Box(spacing=12, margin_top=6)
        row.pack_start(Gtk.Label(label="Power mode", xalign=0), False, False, 0)
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, SAVER, PERFORMANCE, 1)
        self.scale.set_draw_value(False)
        self.scale.set_round_digits(0)
        self.scale.add_mark(SAVER, Gtk.PositionType.BOTTOM, "Batt")          # Battery saver
        self.scale.add_mark(PERFORMANCE, Gtk.PositionType.BOTTOM, "Pow")     # Best performance
        self.scale.connect("value-changed", self.on_scale)
        row.pack_start(self.scale, True, True, 0)
        box.pack_start(row, False, False, 0)
        box.pack_start(Gtk.Separator(margin_top=4), False, False, 0)
        head = Gtk.Label(xalign=0)
        head.set_markup("<b>What Battery saver does</b>")
        box.pack_start(head, False, False, 0)
        for line in SAVING:
            item = Gtk.Label(label="•  " + (line or cpu_line()), xalign=0, wrap=True, max_width_chars=64)
            box.pack_start(item, False, False, 0)
        self.busy = False
        self.refresh()
        GLib.timeout_add_seconds(3, self.refresh)

    def refresh(self):
        m = mode()
        title, auto, chosen = TEXT[m]
        self.title.set_markup("<span size='large' weight='600'>%s</span>" % GLib.markup_escape_text(title))
        self.sub.set_text(chosen if any(os.path.exists(c) for c in CHOSEN) else auto)
        if not self.busy:
            self.busy = True                    # no "value-changed" round trip
            self.scale.set_value(SAVER if m == "saving" else PERFORMANCE)
            self.busy = False
        return True

    def on_scale(self, scale):
        value = round(scale.get_value())
        want = "saver" if value == SAVER else "full"
        if self.busy or (mode() == "saving") == (value == SAVER):
            return
        try:
            r = subprocess.run(["pkexec", KP, want], stdout=subprocess.DEVNULL,
                               stderr=subprocess.PIPE, timeout=120)
            ok = r.returncode == 0
        except (OSError, subprocess.SubprocessError):
            ok = False
        if not ok:
            self.busy = True
            scale.set_value(PERFORMANCE if value == SAVER else SAVER)
            self.busy = False
        self.refresh()


def main():
    w = Window()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
