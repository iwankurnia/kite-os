#!/bin/sh
set -e
case "$1" in
    remove|purge)
        update-alternatives --remove default.plymouth /usr/share/plymouth/themes/kite/kite.plymouth >/dev/null 2>&1 || true
        rm -rf /usr/share/plymouth/themes/kite
        # kite-power's boost drop-in for low-end CPUs (written at boot)
        rm -f /etc/tlp.d/61-kite-boost.conf
        ;;
esac
if [ "$1" = purge ]; then
    grub_dropin=/etc/default/grub.d/kite-resume.cfg
    had_dropin=
    [ -e "$grub_dropin" ] && had_dropin=1
    rm -f "$grub_dropin" \
          /etc/systemd/logind.conf.d/70-kite-hibernate.conf \
          /etc/systemd/sleep.conf.d/70-kite-hibernate.conf
    # The GRUB drop-in only takes effect through grub.cfg: rebuild it so the
    # resume= parameters go too.
    if [ -n "$had_dropin" ] && command -v update-grub >/dev/null 2>&1; then
        update-grub || true
    fi
fi
exit 0
