#!/usr/bin/python3
"""Update the KiteOS packages (kite-system, kite-desktop, ...) from the latest
KiteOS release on GitHub.

  kite-update            install the newer kite-* packages (asks for sudo)
  kite-update --check    only show what would be updated

Each release carries the kite-*.deb files and kite-packages.sha256 (attached
by the Build ISO workflow). Downloads are checked against that list; GitHub's
HTTPS is the trust anchor (the packages are not separately signed).
Debian, Brave and ONLYOFFICE updates come from apt as usual:
  sudo apt update && sudo apt upgrade
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.request

CONF = "/etc/kite/update.conf"
DEFAULT_REPO = "iwankurnia/kite-os"
DEB = re.compile(r"^(kite-[a-z0-9-]+)_([^_]+)_(all|amd64)\.deb$")
SUMS = "kite-packages.sha256"


def repo():
    try:
        with open(CONF) as f:
            for line in f:
                m = re.match(r"\s*REPO\s*=\s*([\w.-]+/[\w.-]+)", line)
                if m:
                    return m.group(1)
    except OSError:
        pass
    return DEFAULT_REPO


def fetch(url, binary=False):
    req = urllib.request.Request(url, headers={"User-Agent": "kite-update",
                                               "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        data = r.read()
    return data if binary else data.decode()


def installed_version(pkg):
    try:
        r = subprocess.run(["dpkg-query", "-W", "-f", "${db:Status-Abbrev} ${Version}", pkg],
                           capture_output=True, text=True)
    except OSError:
        return None
    status, _, version = r.stdout.partition(" ")
    return version.strip() if r.returncode == 0 and status.startswith("ii") else None


def newer(a, b):
    return subprocess.run(["dpkg", "--compare-versions", a, "gt", b]).returncode == 0


def plan(release, installed=installed_version, is_newer=newer):
    """[(package, installed version, new version, asset)] for installed kite-*
    packages that the release has in a newer version."""
    out = []
    for asset in release.get("assets", []):
        m = DEB.match(asset.get("name", ""))
        if not m:
            continue
        pkg, version = m.group(1), m.group(2)
        have = installed(pkg)
        if have is not None and is_newer(version, have):
            out.append((pkg, have, version, asset))
    return sorted(out, key=lambda x: x[0])


def checksums(text):
    sums = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) == 2 and re.fullmatch(r"[0-9a-f]{64}", parts[0]):
            sums[parts[1].lstrip("*")] = parts[0]
    return sums


def main(args):
    check_only = "--check" in args
    if any(a not in ("--check",) for a in args):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    try:
        release = json.loads(fetch("https://api.github.com/repos/%s/releases/latest" % repo()))
    except Exception as e:  # network, rate limit, no release yet
        print("Could not reach the KiteOS releases on GitHub: %s" % e, file=sys.stderr)
        return 1
    todo = plan(release)
    tag = release.get("tag_name", "?")
    if not todo:
        print("KiteOS is up to date (latest release %s)." % tag)
        return 0
    print("Updates in KiteOS %s:" % tag)
    for pkg, have, version, _ in todo:
        print("  %-16s %s -> %s" % (pkg, have, version))
    if check_only:
        return 0
    if os.geteuid() != 0:
        os.execvp("sudo", ["sudo", sys.executable, os.path.realpath(__file__)] + args)

    assets = {a["name"]: a for a in release.get("assets", [])}
    if SUMS not in assets:
        print("The release has no %s; not installing unchecked files." % SUMS, file=sys.stderr)
        return 1
    sums = checksums(fetch(assets[SUMS]["browser_download_url"]))
    with tempfile.TemporaryDirectory(prefix="kite-update.") as tmp:
        files = []
        for pkg, _, _, asset in todo:
            data = fetch(asset["browser_download_url"], binary=True)
            if hashlib.sha256(data).hexdigest() != sums.get(asset["name"]):
                print("%s: checksum does not match %s; nothing installed." % (asset["name"], SUMS),
                      file=sys.stderr)
                return 1
            path = os.path.join(tmp, asset["name"])
            with open(path, "wb") as f:
                f.write(data)
            files.append(path)
        os.chmod(tmp, 0o755)   # apt's sandbox user must be able to read the files
        env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
        subprocess.run(["apt-get", "update", "-q"], env=env)
        # New Debian dependencies come in with the packages; settings you
        # changed under /etc are kept.
        r = subprocess.run(["apt-get", "install", "-y", "-q",
                            "-o", "Dpkg::Options::=--force-confdef",
                            "-o", "Dpkg::Options::=--force-confold"] + files, env=env)
    if r.returncode == 0:
        print("KiteOS updated to %s. Log out and in again to see desktop changes." % tag)
    return r.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
