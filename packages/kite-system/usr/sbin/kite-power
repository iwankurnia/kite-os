#!/usr/bin/python3
"""KiteOS power mode: Battery saver or Best performance.

By default the mode follows the charger: Battery saver on battery, Best
performance plugged in. The battery pop-up and Settings > Battery choose
the other one, plugged in or not, until the charger is plugged in or
unplugged, or the laptop restarts (the choice lives in /run and remembers
whether the charger was in when it was made).

  kite-power              show the mode and what is in force
  kite-power apply        apply KiteOS's part for the current mode (run on
                          plugging in or out by udev, and at boot)
  kite-power full         Best performance, even on battery
  kite-power saver        Battery saver, even when plugged in
  kite-power auto         back to following the charger

TLP (/etc/tlp.d/60-kite.conf) does the CPU energy policy and turbo, PCI
Express link power, runtime power management of the drivers, USB autosuspend,
Wi-Fi and audio power saving. kite-power does what TLP does not:

  * P/E cores (Intel 12th gen and later): on battery, system services
    (system.slice) run on the E-cores only; apps may use every core.
  * Intel graphics (i915): the GPU's top speed is capped at 60 % of its range
    on battery.
  * Low-end CPUs (no P/E cores, 4 logical CPUs or fewer: the N4020 has 2)
    keep their boost on battery: at a 1.1 GHz base speed the web is too slow.
    kite-power writes /etc/tlp.d/61-kite-boost.conf for TLP (turbo and HWP
    dynamic boost on, energy policy balance_power) and removes it on any
    other CPU. The CPU does not change, so the file is written once.
  * /run/kite/power says "ac", "saving" or "full" for the desktop
    (Settings > Battery, the battery pop-up; start-compositor if
    ANIMATIONS_ON_BATTERY=0): "saving" whenever power is being saved, on
    battery or by choice.

"full", "saver" and "auto" are what Settings > Battery and the battery
pop-up run (pkexec, polkit action org.kiteos.power, no password for the
person at the laptop).
"""
import glob
import os
import subprocess
import sys

SYS = os.environ.get("KITE_SYS", "/sys")
RUN = os.environ.get("KITE_RUN", "/run/kite")
STATE = os.path.join(RUN, "power")
FULL = os.path.join(RUN, "power-full")
SAVER = os.path.join(RUN, "power-saver")
GPU_SHARE = 0.6                 # share of the GPU's range kept on battery
BOOST_CONF = os.environ.get("KITE_TLP_BOOST", "/etc/tlp.d/61-kite-boost.conf")
LOW_END_CPUS = 4                # this many logical CPUs or fewer: low-end
BOOST_TEXT = """# Written by kite-power: this is a low-end CPU (%d logical CPUs, no P/E
# cores), so it keeps its boost on battery; at its base speed the web is too
# slow. Read after 60-kite.conf. kite-power removes this file on other CPUs.
CPU_BOOST_ON_BAT=1
CPU_HWP_DYN_BOOST_ON_BAT=1
CPU_ENERGY_PERF_POLICY_ON_BAT=balance_power
"""


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def on_battery():
    """True when a laptop battery is there and no charger is online. Device
    batteries (a wireless mouse's: scope Device) do not count."""
    batteries, online = False, False
    for d in sorted(glob.glob(os.path.join(SYS, "class/power_supply/*"))):
        kind = read(os.path.join(d, "type"))
        if kind == "Battery":
            if read(os.path.join(d, "scope")) != "Device" and read(os.path.join(d, "present"), "1") == "1":
                batteries = True
        elif read(os.path.join(d, "online")) == "1":
            online = True                   # Mains, USB, USB-C/PD chargers
    return batteries and not online


def charger():
    return "battery" if on_battery() else "plugged"


def drop_stale_choice():
    """A chosen mode lasts until the charger is plugged in or unplugged: its
    file says which it was when the choice was made. True if one went."""
    gone = False
    for path in (FULL, SAVER):
        if os.path.exists(path) and read(path) != charger():
            try:
                os.remove(path)
                gone = True
            except OSError:
                pass
    return gone


def mode():
    if os.path.exists(FULL):
        return "full"
    if os.path.exists(SAVER):
        return "saving"
    return "saving" if on_battery() else "ac"


def tlp_mode():
    """TLP's command for the chosen mode: its plugged-in or battery settings
    whatever the charger says, or back to following the charger."""
    if os.path.exists(FULL):
        return "ac"
    if os.path.exists(SAVER):
        return "bat"
    return "start"


def cpu_list(text):
    """"0-3,8" -> [0, 1, 2, 3, 8]"""
    out = []
    for part in text.split(","):
        part = part.strip()
        if "-" in part:
            a, b = part.split("-", 1)
            out.extend(range(int(a), int(b) + 1))
        elif part.isdigit():
            out.append(int(part))
    return out


def e_cores():
    """The E-cores of an Intel hybrid CPU ("16-21"), or None (all cores alike)."""
    atom = read(os.path.join(SYS, "devices/cpu_atom/cpus"))
    core = read(os.path.join(SYS, "devices/cpu_core/cpus"))
    return atom if atom and core and cpu_list(atom) else None


def cpu_count():
    """Logical CPUs present, or 0 if unknown."""
    return len(cpu_list(read(os.path.join(SYS, "devices/system/cpu/present"))))


def low_end():
    """A low-end CPU keeps its boost on battery: no P/E cores and at most
    LOW_END_CPUS logical CPUs (Celeron/Pentium Silver N4020, N5000, N100)."""
    n = cpu_count()
    return 0 < n <= LOW_END_CPUS and e_cores() is None


def tune_boost():
    """Write or remove TLP's boost drop-in for this CPU. True if it changed."""
    want = BOOST_TEXT % cpu_count() if low_end() else None
    if os.path.exists(BOOST_CONF):
        try:
            with open(BOOST_CONF) as f:
                have = f.read()
        except OSError:
            have = ""
    else:
        have = None
    if want == have:
        return False
    if want is None:
        try:
            os.remove(BOOST_CONF)
        except OSError:
            return False
        return True
    return write(BOOST_CONF, want)


def gpus():
    """[(card dir, lowest MHz, highest MHz)] for Intel i915 GPUs."""
    out = []
    for d in sorted(glob.glob(os.path.join(SYS, "class/drm/card[0-9]"))):
        rpn, rp0 = read(os.path.join(d, "gt_RPn_freq_mhz")), read(os.path.join(d, "gt_RP0_freq_mhz"))
        if rpn.isdigit() and rp0.isdigit() and int(rp0) > int(rpn):
            out.append((d, int(rpn), int(rp0)))
    return out


def gpu_cap(rpn, rp0):
    """Top GPU speed while saving: GPU_SHARE of the way from lowest to highest."""
    return int(rpn + GPU_SHARE * (rp0 - rpn))


def write(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(value))
        return True
    except OSError as e:
        print("kite-power: %s: %s" % (path, e.strerror), file=sys.stderr)
        return False


def run(*argv):
    try:
        return subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=60).returncode
    except (OSError, subprocess.SubprocessError) as e:
        print("kite-power: %s: %s" % (argv[0], e), file=sys.stderr)
        return 1


def apply():
    if drop_stale_choice():
        run("tlp", "start")         # TLP follows the charger again too
    m = mode()
    saving = m == "saving"
    os.makedirs(RUN, exist_ok=True)
    write(STATE, m + "\n")
    done = ["mode %s" % m]
    if tune_boost():
        # First boot on this CPU: TLP has already applied 60-kite.conf alone.
        run("tlp", tlp_mode())
        done.append("TLP boost drop-in %s" % ("written" if low_end() else "removed"))
    ec = e_cores()
    if ec:
        # AllowedCPUs= (empty) puts the services back on every core.
        run("systemctl", "set-property", "--runtime", "system.slice", "AllowedCPUs=" + (ec if saving else ""))
        done.append("services on %s" % ("E-cores " + ec if saving else "all cores"))
    for d, rpn, rp0 in gpus():
        top = gpu_cap(rpn, rp0) if saving else rp0
        # boost first: the driver may refuse a top speed below the boost speed
        for name in (("gt_boost_freq_mhz", "gt_max_freq_mhz") if saving else
                     ("gt_max_freq_mhz", "gt_boost_freq_mhz")):
            write(os.path.join(d, name), top)
        done.append("GPU %s up to %d MHz" % (os.path.basename(d), top))
    print("kite-power: " + ", ".join(done))
    return 0


def status():
    m = mode()
    chosen = os.path.exists(FULL) or os.path.exists(SAVER)
    print({"ac": "Best performance (plugged in).",
           "saving": "Battery saver (%s)." % ("chosen, until the charger is plugged in or out, or a restart" if chosen else "on battery"),
           "full": "Best performance (chosen, until the charger is plugged in or out, or a restart)."}[m])
    print("TLP:          %s" % ("installed" if os.path.exists("/usr/sbin/tlp") else "not installed"))
    ec = e_cores()
    print("P/E cores:    %s" % ("E-cores %s (services there on battery)" % ec if ec else "no (all cores alike)"))
    print("CPU boost:    %s" % ("kept on battery (low-end CPU, %d logical CPUs)" % cpu_count() if low_end()
                                else "off on battery"))
    for d, rpn, rp0 in gpus():
        print("GPU %s:     %d-%d MHz, up to %d MHz on battery, now up to %s MHz"
              % (os.path.basename(d), rpn, rp0, gpu_cap(rpn, rp0), read(os.path.join(d, "gt_max_freq_mhz"), "?")))
    return 0


def main(args):
    if not args:
        return status()
    cmd = args[0]
    if cmd not in ("apply", "full", "saver", "auto") or len(args) > 1:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("kite-power: run it as root (sudo kite-power %s)" % cmd, file=sys.stderr)
        return 1
    if cmd in ("full", "saver", "auto"):
        os.makedirs(RUN, exist_ok=True)
        for path, want in ((FULL, cmd == "full"), (SAVER, cmd == "saver")):
            if want:
                write(path, charger() + "\n")
            else:
                try:
                    os.remove(path)
                except OSError:
                    pass
        # TLP: its plugged-in (ac) or battery (bat) settings until
        # "tlp start", which follows the charger again
        run("tlp", tlp_mode())
    return apply()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
