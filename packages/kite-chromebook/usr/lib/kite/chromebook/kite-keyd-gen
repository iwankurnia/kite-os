#!/usr/bin/python3
"""Write a keyd config that makes a Chromebook keyboard behave like ChromeOS.

The top-row layout differs between Chromebooks, so it is read from the
firmware (function_row_physmap). Based on WeirdTreeThing/cros-keyboard-map
(BSD-3-Clause), extended with ChromeOS habits:
  * tap Search             -> app launcher (sends Super+Space)
  * Search + top-row key   -> F1..F10
  * Search + Backspace     -> Delete;  Search + arrows -> Home/End/PgUp/PgDn
  * Ctrl+Alt + top-row key -> switch to text console n
"""
import argparse
import sys

PHYSMAP = "/sys/bus/platform/devices/i8042/serio0/function_row_physmap"

# Scancode (as listed in function_row_physmap) -> keyd key name.
VIVALDI = {
    "90": "previoussong", "91": "zoom", "92": "scale", "93": "sysrq",
    "94": "brightnessdown", "95": "brightnessup", "97": "kbdillumdown",
    "98": "kbdillumup", "99": "nextsong", "9A": "playpause", "9B": "micmute",
    "9E": "kbdillumtoggle", "A0": "mute", "AE": "volumedown", "B0": "volumeup",
    "DD": "sysrq", "E9": "forward", "EA": "back", "E7": "refresh",
}

# What a top-row key should do when pressed on its own, if not just itself.
ACTION = {
    "zoom": "f11",     # "full screen" key: most apps understand F11
    "scale": "M-w",    # "overview" key: KiteOS binds Super+W to the window overview
}

# Classic 10-key layout, used when the firmware publishes no physmap.
DEFAULT_PHYSMAP = ["EA", "E9", "E7", "91", "92", "94", "95", "A0", "AE", "B0"]

IDS = [
    "k:0001:0001",  # AT keyboard (internal keyboard with MrChromebox firmware)
    "k:0000:0000",  # cros_ec keyboard
]


def read_physmap(path):
    try:
        with open(path) as fh:
            codes = fh.read().split()
    except OSError:
        return None
    codes = [c.upper() for c in codes if c.upper() in VIVALDI]
    return codes or None


def build_config(codes, source):
    keys = [VIVALDI[c] for c in codes]
    out = [
        "# Generated by kite-keyd-gen — regenerated at every boot, edits are lost.",
        "# Put your own keyd tweaks in another file in /etc/keyd/.",
        f"# Top row ({source}): {' '.join(codes)}",
        "",
        "[ids]",
        *IDS,
        "",
        "[main]",
        "# Search key: tap opens the launcher, hold works as Super.",
        "leftmeta = overload(meta, M-space)",
        "# Top row does what is printed on it (whether the firmware sends",
        "# F-keys or media keys).",
    ]
    for i, k in enumerate(keys, 1):
        act = ACTION.get(k, k)
        out.append(f"f{i} = {act}")
        out.append(f"{k} = {act}")
    out += ["", "[meta]", "# Search + top row = function keys."]
    for i, k in enumerate(keys, 1):
        out.append(f"f{i} = f{i}")
        out.append(f"{k} = f{i}")
    out += [
        "backspace = delete",
        "left = home",
        "right = end",
        "up = pageup",
        "down = pagedown",
        "",
        "[alt]",
        "backspace = delete",
        "brightnessdown = kbdillumdown",
        "brightnessup = kbdillumup",
        "",
        "[control+alt]",
        "backspace = C-A-delete",
    ]
    for i, k in enumerate(keys, 1):
        out.append(f"f{i} = C-A-f{i}")
        out.append(f"{k} = C-A-f{i}")
    return "\n".join(out) + "\n"


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("-o", "--output", default="-", help="file to write (default: stdout)")
    ap.add_argument("--physmap", default=PHYSMAP, help="physmap file to read")
    args = ap.parse_args()

    codes = read_physmap(args.physmap)
    source = "from firmware"
    if not codes:
        codes, source = DEFAULT_PHYSMAP, "default layout, no physmap found"
    text = build_config(codes, source)
    if args.output == "-":
        sys.stdout.write(text)
    else:
        with open(args.output, "w") as fh:
            fh.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
