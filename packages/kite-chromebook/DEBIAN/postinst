#!/bin/sh
set -e
case "$1" in
    configure)
        systemctl enable kite-chromebook-setup.service >/dev/null 2>&1 || true
        systemctl enable keyd.service >/dev/null 2>&1 || true
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            /usr/lib/kite/chromebook/kite-chromebook-setup || true
        fi
        ;;
    triggered)
        /usr/lib/kite/chromebook/kite-chromebook-setup --ucm-only || true
        ;;
esac
exit 0
