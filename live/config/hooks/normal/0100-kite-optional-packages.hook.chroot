#!/bin/sh
# Packages whose name differs between Debian releases, or that are optional:
# install the first available candidate of each group.
set -e
export DEBIAN_FRONTEND=noninteractive

available() {
    apt-cache policy "$1" 2>/dev/null | grep -q '^  Candidate: [0-9a-z]'
}
first_of() {
    for p in "$@"; do
        if available "$p"; then
            apt-get install -y --no-install-recommends "$p"
            return 0
        fi
    done
    echo "W: kite: none of [$*] is available, skipped" >&2
}

first_of firmware-intel-graphics firmware-misc-nonfree       # i915 DMC/GuC firmware
first_of firmware-intel-misc
first_of network-manager-applet network-manager-gnome        # Wi-Fi icon in the shelf
first_of blueman                                             # Bluetooth settings
first_of mate-polkit lxpolkit                                # password prompts
first_of fonts-roboto fonts-roboto-unhinted                  # ChromeOS-like font
first_of plymouth-label                                      # text in the boot splash
