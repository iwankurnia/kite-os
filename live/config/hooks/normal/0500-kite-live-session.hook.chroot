#!/bin/sh
# Live-session-only tweaks. Undone in the installed system by
# /usr/lib/kite/installer/finish-install.
set -e
# "Install KiteOS" is pinned first on the taskbar by kite-layout whenever
# its launcher exists, i.e. only in the live session.
# Debian's own installer entry would duplicate "Install KiteOS".
rm -f /usr/share/applications/calamares-install-debian.desktop
# Debian's autostart that copies its installer icon to the desktop: KiteOS has
# no desktop icons, and it logged an error at every live start.
grep -l 'add-calamares-desktop-icon' /etc/xdg/autostart/*.desktop 2>/dev/null | xargs -r rm -f
# Icon caches for every theme: the "Install KiteOS" icon is added from
# includes.chroot after the packages built the hicolor cache, and Papirus and
# Adwaita were set up before the cache tool was installed, so they had none
# (every GTK app then scans Papirus's 43,000 files when it starts).
for t in /usr/share/icons/*/; do
    [ -f "$t/index.theme" ] && gtk-update-icon-cache -f -q "$t" 2>/dev/null || true
done
# No automatic screen lock in the live session (nobody knows its password).
cat > /etc/xdg/autostart/kite-live-nolock.desktop <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=KiteOS live session: no screen lock
Exec=sh -c 'xfconf-query -c xfce4-screensaver -p /lock/enabled -n -t bool -s false; xfconf-query -c xfce4-screensaver -p /saver/enabled -n -t bool -s false'
NoDisplay=true
OnlyShowIn=XFCE;
DESKTOP
