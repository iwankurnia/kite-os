#!/bin/sh
# The Fluent GTK + xfwm4 theme for the KiteOS desktop, which Debian does not
# package, from the same pinned upstream release as docker-crd-vstunnel.
# (Icons: Papirus-Light, from Debian.) Until KiteOS 1.3 this also installed
# Qogir and WhiteSur for the mac layout, which is gone.
# Theme updates come with a new ISO only (kite-update does not carry them).
set -eu
work=$(mktemp -d)
cd "$work"

get() {  # get REPOSITORY TAG
    curl -fsSL --retry 3 "https://github.com/vinceliuice/$1/archive/refs/tags/$2.tar.gz" | tar -xz
}

get Fluent-gtk-theme 2025-04-17
bash Fluent-gtk-theme-*/install.sh -d /usr/share/themes -c light -s standard

cd /
rm -rf "$work"

test -f /usr/share/themes/Fluent-Light/gtk-3.0/gtk.css
test -f /usr/share/themes/Fluent-Light/xfwm4/themerc

du -sh /usr/share/themes/Fluent-Light 2>/dev/null || true
