# Kernel and firmware for the HP Chromebook 11 G8 EE (Gemini Lake, Intel
# Wi-Fi 9560, SOF audio) — only what this hardware needs, to keep it small.
linux-image-amd64
firmware-linux-free
firmware-iwlwifi
firmware-sof-signed
firmware-intel-graphics
firmware-intel-misc
intel-microcode
intel-media-va-driver
libgl1-mesa-dri

# Core system
systemd-sysv
systemd-timesyncd
# hwclock, used by the installer to set the hardware clock (not in util-linux on Debian 13)
util-linux-extra
dbus-user-session
initramfs-tools
sudo
polkitd
pkexec
locales
console-setup
keyboard-configuration
tzdata
ca-certificates
bash-completion
less
nano
curl
zstd
unzip
e2fsprogs
dosfstools
exfatprogs
grub-efi-amd64
efibootmgr

# Network, Bluetooth, sound, power
network-manager
wpasupplicant
bluez
blueman
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
# PipeWire's Bluetooth audio (libspa-0.2-bluetooth) is a dependency of
# kite-desktop, so kite-update brings it to installed systems too.
alsa-utils
alsa-ucm-conf
upower
earlyoom
plymouth
plymouth-themes
plymouth-label
