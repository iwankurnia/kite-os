# Browser, office suite and code editor, from their vendors' APT repositories
# (added by scripts/fetch-vendor-keys.sh into config/archives/).
brave-browser
onlyoffice-desktopeditors
code
# ONLYOFFICE needs it but does not depend on it ("libxcb-shape.so.0: cannot
# open shared object file"); kite-desktop depends on it too, for kite-update.
libxcb-shape0
# Version control (Debian)
git
# Media player (Debian). No Recommends, so no skins, visualisations or
# Samba/extra access plugins; hardware decoding through VA-API
# (intel-media-va-driver, in kite-base). Default for audio and video files
# (kite-desktop's mimeapps.list).
vlc
