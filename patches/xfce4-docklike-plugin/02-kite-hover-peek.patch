@@ -16,6 +16,22 @@
 
 class Group;
 class GroupMenuItem;
+class GroupWindow;
+
+// KiteOS: peek at a window from its preview in the pop-up, like Windows 11.
+// Hovering a preview for a moment brings its window to the front; leaving the
+// pop-up (or it closing) without a click puts back the window that was active
+// before, and minimises a peeked window again if it was minimised. Only the
+// pop-up a peek started in can end it: docklike hides every other button's
+// pop-up whenever one opens.
+namespace Peek
+{
+	void schedule(GroupWindow* groupWindow, GtkWidget* popup);
+	void cancel();
+	void forget(GroupWindow* groupWindow);
+	void commit();
+	void restore(GtkWidget* popup);
+} // namespace Peek
 
 class GroupMenu
 {

