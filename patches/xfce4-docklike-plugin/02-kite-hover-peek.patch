--- a/src/GroupMenu.cpp
+++ b/src/GroupMenu.cpp
@@ -13,6 +13,144 @@
 #include "GroupMenu.hpp"
 #include "GroupMenuItem.hpp"
 #include "Plugin.hpp"
+#include "Xfw.hpp"
+
+#ifdef ENABLE_X11
+#include <gdk/gdkx.h>
+#endif
+
+namespace Peek
+{
+	static const guint DELAY_MS = 300;
+
+	static XfwWindow* sBefore = nullptr; // active before the first peek
+	static XfwWindow* sPeeked = nullptr; // the window brought forward
+	static bool sPeekedWasMinimized = false;
+	static bool sOpen = false; // a peek has happened since the pop-up opened
+	static GroupWindow* sPending = nullptr;
+	static GtkWidget* sPopup = nullptr;
+	static guint sTimer = 0;
+
+	// Weak pointers: a window closed mid-peek clears its slot.
+	static void track(XfwWindow** slot, XfwWindow* window)
+	{
+		if (*slot != nullptr)
+			g_object_remove_weak_pointer(G_OBJECT(*slot), (gpointer*)slot);
+		*slot = window;
+		if (window != nullptr)
+			g_object_add_weak_pointer(G_OBJECT(window), (gpointer*)slot);
+	}
+
+	// The window manager ignores activation with no timestamp.
+	static guint32 now()
+	{
+#ifdef ENABLE_X11
+		GdkWindow* gdkWindow = sPopup != nullptr ? gtk_widget_get_window(sPopup) : nullptr;
+		if (gdkWindow != nullptr && GDK_IS_X11_WINDOW(gdkWindow))
+			return gdk_x11_get_server_time(gdkWindow);
+#endif
+		return gtk_get_current_event_time();
+	}
+
+	static gboolean raisePopup(gpointer)
+	{
+		GdkWindow* gdkWindow = sPopup != nullptr ? gtk_widget_get_window(sPopup) : nullptr;
+		if (gdkWindow != nullptr && gtk_widget_get_visible(sPopup))
+			gdk_window_raise(gdkWindow);
+		return G_SOURCE_REMOVE;
+	}
+
+	static void keepPopupOnTop()
+	{
+		raisePopup(nullptr);
+		g_timeout_add(100, raisePopup, nullptr);
+		g_timeout_add(250, raisePopup, nullptr);
+	}
+
+	static void putBackPeeked()
+	{
+		if (sPeeked != nullptr && sPeekedWasMinimized)
+			xfw_window_set_minimized(sPeeked, TRUE, nullptr);
+		track(&sPeeked, nullptr);
+		sPeekedWasMinimized = false;
+	}
+
+	static void show(GroupWindow* groupWindow)
+	{
+		XfwWindow* window = groupWindow->mXfwWindow;
+		if (window == sPeeked)
+			return;
+		if (!sOpen)
+		{
+			sOpen = true;
+			track(&sBefore, Xfw::getActiveWindow());
+		}
+		putBackPeeked();
+		track(&sPeeked, window);
+		sPeekedWasMinimized = xfw_window_is_minimized(window);
+		if (sPeekedWasMinimized || window != Xfw::getActiveWindow())
+		{
+			xfw_window_activate(window, nullptr, now(), nullptr);
+			// The window manager raises the peeked window above the pop-up
+			// (an unmanaged window) a moment later: put the pop-up back on top.
+			keepPopupOnTop();
+		}
+	}
+
+	void cancel()
+	{
+		if (sTimer != 0)
+			g_source_remove(sTimer);
+		sTimer = 0;
+		sPending = nullptr;
+	}
+
+	void schedule(GroupWindow* groupWindow, GtkWidget* popup)
+	{
+		cancel();
+		sPopup = popup;
+		sPending = groupWindow;
+		sTimer = g_timeout_add(DELAY_MS, +[](gpointer) -> gboolean {
+			sTimer = 0;
+			GroupWindow* pending = sPending;
+			sPending = nullptr;
+			if (pending != nullptr)
+				show(pending);
+			return G_SOURCE_REMOVE;
+		},
+			nullptr);
+	}
+
+	void forget(GroupWindow* groupWindow)
+	{
+		if (sPending == groupWindow)
+			cancel();
+	}
+
+	void commit()
+	{
+		cancel();
+		track(&sPeeked, nullptr);
+		track(&sBefore, nullptr);
+		sPeekedWasMinimized = false;
+		sOpen = false;
+	}
+
+	void restore(GtkWidget* popup)
+	{
+		if (popup != sPopup)
+			return;
+		cancel();
+		if (!sOpen)
+			return;
+		bool peeked = sPeeked != nullptr;
+		putBackPeeked();
+		if (peeked && sBefore != nullptr && !xfw_window_is_minimized(sBefore))
+			xfw_window_activate(sBefore, nullptr, now(), nullptr);
+		track(&sBefore, nullptr);
+		sOpen = false;
+	}
+} // namespace Peek
 
