@@ -14,6 +14,18 @@
 
 static GtkTargetEntry entries[1] = {{(gchar*)"any", 0, 0}};
 
+// previewHeight (pixels, 0 = off): every preview is that high, as wide as the
+// window's shape gives, but at least 4:3 and at most 2.2:1 of the height, so
+// very narrow and very wide windows still get a tidy tile. The tile is as wide
+// as its preview; the title is shortened to fit.
+static void previewBox(int winWidth, int winHeight, int* boxWidth, int* boxHeight)
+{
+	int height = Settings::previewHeight;
+	int width = winHeight > 0 ? (int)((double)winWidth * height / winHeight) : height * 16 / 9;
+	*boxHeight = height;
+	*boxWidth = CLAMP(width, height * 4 / 3, height * 22 / 10);
+}
