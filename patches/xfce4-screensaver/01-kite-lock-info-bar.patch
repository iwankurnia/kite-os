+/* KiteOS: the info bar shares the window's column with the unlock dialog.
+ * Shown while the dialog is up (after a resume from suspend it was, with no
+ * message), it takes 45 px from the dialog, which is centred and then sits
+ * 23 px too high: its top bar off the screen, a black strip at the bottom.
+ * While the dialog is up the info bar stays hidden. */
+static gboolean
+info_bar_hide_idle (gpointer data) {
+    GSWindow *window = GS_WINDOW (data);
+    if (window->priv->info_bar != NULL && window->priv->dialog_up)
+        gtk_widget_hide (window->priv->info_bar);
+    g_object_unref (window);
+    return FALSE;
+}
+
+static void
+info_bar_shown (GtkWidget *info_bar,
+                GSWindow  *window) {
+    if (window->priv->dialog_up) {
+        gs_debug ("Info bar shown while the unlock dialog is up: hiding it");
+        g_idle_add (info_bar_hide_idle, g_object_ref (window));
+    }
+}
+
 static void
 create_info_bar (GSWindow *window) {
     window->priv->info_bar = gtk_info_bar_new ();
     gtk_widget_set_no_show_all (window->priv->info_bar, TRUE);
     gtk_box_pack_end (GTK_BOX (window->priv->vbox), window->priv->info_bar, FALSE, FALSE, 0);
+    g_signal_connect (window->priv->info_bar, "show", G_CALLBACK (info_bar_shown), window);
 }
 
 static gboolean
